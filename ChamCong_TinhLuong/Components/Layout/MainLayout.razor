@inherits LayoutComponentBase
@inject UserSessionService UserSession
@inject NavigationManager Navigation
@implements IDisposable

@if (!UserSession.IsAuthenticated)
{
    <!-- Khi chưa đăng nhập: Hiển thị Màn hình Đăng Nhập (Login Screen) -->
    <ChamCong_TinhLuong.Components.Pages.Login OnLoginSuccess="StateHasChanged" />
}
else
{
    <!-- Khi đã đăng nhập: Hiển thị Giao diện Làm việc chính thức -->
    <div class="page">
        <div class="sidebar">
            <NavMenu />
        </div>

        <main>
            <!-- Top Application Header Bar -->
            <header class="top-row px-4 d-flex justify-content-between align-items-center bg-white border-bottom shadow-2xs">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-light text-secondary border fw-medium px-2.5 py-1.5 d-none d-sm-inline-flex align-items-center gap-1">
                        <i class="bi bi-shield-check text-success"></i> Clean Architecture (.NET 8)
                    </span>
                    <span class="badge bg-success-subtle text-success border border-success-subtle fw-medium px-2.5 py-1.5 d-none d-md-inline-flex align-items-center gap-1">
                        <i class="bi bi-database-check"></i> SQL Server Connected
                    </span>
                    <span class="text-muted small d-none d-lg-inline">
                        | Kỳ làm việc: <strong>Tháng 10/2026</strong>
                    </span>
                </div>

                <!-- Logged in Account Profile & Logout Button -->
                <div class="d-flex align-items-center gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <div class="avatar-circle @(UserSession.IsAdminHr ? "bg-primary" : "bg-success") text-white fw-bold d-flex align-items-center justify-content-center shadow-xs" style="width: 34px; height: 34px; border-radius: 50%; font-size: 12px;">
                            @(UserSession.IsAdminHr ? "HR" : UserSession.CurrentEmployeeCode)
                        </div>
                        <div class="d-none d-sm-block text-end">
                            <div class="fw-bold small text-dark lh-1">@UserSession.CurrentEmployeeName</div>
                            <span class="badge @(UserSession.IsAdminHr ? "bg-primary-subtle text-primary border border-primary-subtle" : "bg-success-subtle text-success border border-success-subtle")" style="font-size: 10px;">
                                <i class="bi @(UserSession.IsAdminHr ? "bi-shield-shaded" : "bi-person-check") me-1"></i>
                                @(UserSession.IsAdminHr ? "Kế toán / HR Admin" : $"Nhân viên ({UserSession.CurrentEmployeeCode})")
                            </span>
                        </div>
                    </div>

                    <div class="vr d-none d-sm-block"></div>

                    <!-- Nút Đăng Xuất -->
                    <button class="btn btn-sm btn-outline-danger fw-semibold d-flex align-items-center gap-1 shadow-2xs" @onclick="HandleLogout">
                        <i class="bi bi-box-arrow-right"></i>
                        <span class="d-none d-sm-inline">Đăng Xuất</span>
                    </button>
                </div>
            </header>

            <!-- Main Content Area -->
            <article class="content px-3 px-md-4 py-3">
                @Body
            </article>
        </main>
    </div>
}

<div id="blazor-error-ui">
    Đã xảy ra lỗi không mong muốn.
    <a href="" class="reload">Tải lại trang</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    protected override void OnInitialized()
    {
        UserSession.OnChange += StateHasChanged;
    }

    private void HandleLogout()
    {
        UserSession.Logout();
        Navigation.NavigateTo("/", forceLoad: false);
    }

    public void Dispose()
    {
        UserSession.OnChange -= StateHasChanged;
    }
}
