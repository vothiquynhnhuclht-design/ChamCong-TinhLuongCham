@inject UserSessionService UserSession
@implements IDisposable

<!-- Sidebar Brand Header -->
<div class="sidebar-brand-wrapper px-3.5 py-3.5 d-flex align-items-center justify-content-between">
    <a class="d-flex align-items-center gap-2.5 text-decoration-none" href="">
        <div class="brand-badge-box d-flex align-items-center justify-content-center text-white">
            <i class="bi bi-box-seam-fill fs-5"></i>
        </div>
        <div class="d-flex flex-column">
            <span class="brand-title">HRM Enterprise</span>
            <span class="brand-subtitle">TechCorp SaaS</span>
        </div>
    </a>
    <span class="badge-version">v2.5</span>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler d-md-none" id="sidebarToggle" />
<label for="sidebarToggle" class="mobile-toggle-btn d-md-none">
    <i class="bi bi-list fs-5"></i>
</label>

<!-- Navigation Links (6 Clean Menu Items) -->
<div class="nav-scrollable custom-scrollbar">
    <nav class="flex-column py-3 px-2.5">
        <div class="nav-item mb-2">
            <NavLink class="nav-link custom-sidebar-link" href="" Match="NavLinkMatch.All">
                <i class="bi bi-house-door-fill nav-icon"></i>
                <span class="nav-label">Tổng quan</span>
            </NavLink>
        </div>

        <div class="nav-item mb-2">
            <NavLink class="nav-link custom-sidebar-link" href="employees">
                <i class="bi bi-people nav-icon"></i>
                <span class="nav-label">Nhân sự</span>
            </NavLink>
        </div>

        <div class="nav-item mb-2">
            <NavLink class="nav-link custom-sidebar-link" href="attendance">
                <i class="bi bi-clock nav-icon"></i>
                <span class="nav-label">Chấm công & Thời gian</span>
            </NavLink>
        </div>

        <div class="nav-item mb-2">
            <NavLink class="nav-link custom-sidebar-link" href="payroll">
                <i class="bi bi-currency-dollar nav-icon"></i>
                <span class="nav-label">Lương & Phúc lợi</span>
            </NavLink>
        </div>

        @if (UserSession.IsAdminHr)
        {
            <div class="nav-item mb-2">
                <NavLink class="nav-link custom-sidebar-link" href="reports">
                    <i class="bi bi-bar-chart-line nav-icon"></i>
                    <span class="nav-label">Báo cáo</span>
                </NavLink>
            </div>
        }

        <div class="nav-item mb-2">
            <NavLink class="nav-link custom-sidebar-link" href="ai-assistant">
                <i class="bi bi-gear nav-icon"></i>
                <span class="nav-label">Thiết lập</span>
            </NavLink>
        </div>
    </nav>

    <!-- Bottom User Profile Card -->
    <div class="sidebar-user-footer px-2.5 pb-3.5 mt-auto">
        <a href="employees" class="sidebar-user-card p-2.5 rounded-3 d-flex align-items-center justify-content-between text-decoration-none">
            <div class="d-flex align-items-center gap-2.5 overflow-hidden">
                <div class="user-avatar-hr d-flex align-items-center justify-content-center text-white fw-bold">
                    HR
                </div>
                <div class="user-card-title text-truncate text-white fw-medium">
                    @(UserSession.IsAdminHr ? "Quản trị viên / HR" : UserSession.CurrentEmployeeName)
                </div>
            </div>
            <i class="bi bi-chevron-right text-white-50" style="font-size: 11px;"></i>
        </a>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        UserSession.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        UserSession.OnChange -= StateHasChanged;
    }
}
