@* Reusable Component (Tiêu chí K3.1 & K4.2): Hiển thị cảnh báo chặn truy cập trái phép URL quản trị *@

<div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 text-center bg-white my-4">
    <i class="bi bi-shield-lock-fill fs-1 text-danger d-block mb-3"></i>
    <h4 class="fw-bold text-dark">@Title</h4>
    <p class="text-muted mb-3">
        @Description<br />
        Tài khoản hiện tại (<strong>@EmployeeCode - @EmployeeName</strong>) không có quyền truy cập chức năng này.
    </p>
    <div class="d-flex flex-wrap justify-content-center gap-2 mt-3">
        <a href="payroll" class="btn btn-primary">
            <i class="bi bi-receipt me-1"></i>Xem Phiếu Lương Của Tôi
        </a>
        <a href="/" class="btn btn-outline-secondary">
            <i class="bi bi-house me-1"></i>Về Trang Tổng Quan
        </a>
        @if (OnLogoutClicked.HasDelegate)
        {
            <button type="button" class="btn btn-outline-danger" @onclick="() => OnLogoutClicked.InvokeAsync()">
                <i class="bi bi-box-arrow-right me-1"></i>Đổi Tài Khoản
            </button>
        }
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "Khu Vực Dành Riêng Cho Quản Trị / Nhân Sự - Kế Toán";
    [Parameter] public string Description { get; set; } = "Chức năng này chỉ dành cho tài khoản Quản trị viên hoặc Bộ phận Nhân sự - Kế toán.";
    [Parameter] public string EmployeeCode { get; set; } = string.Empty;
    [Parameter] public string EmployeeName { get; set; } = string.Empty;
    [Parameter] public EventCallback OnLogoutClicked { get; set; }
}
