</style>

@code {
    private int selectedMonth = 10;
    private int selectedYear = 2026;
    private int filterEmployeeId = 0;
    private string filterStatus = "";
    private string? alertMessage;
    private bool isSuccessAlert = true;
    private List<Employee> employeeList = new();

    // Tab quản trị
    private string activeAdminTab = "pending"; // "pending" hoặc "draft"
    private List<TimeAttendance> pendingAttendances = new();

    // Thuộc tính dành cho nhân viên chấm công
    private bool isCheckInAction = true;
    private string employeeCheckInNote = "";
    private bool isScanning = false;
    private bool scanSuccess = false;
    private List<TimeAttendance> personalAttendances = new();
    private int selectedShiftId = 1;

    // Quản lý Camera HTML5 WebRTC
    private readonly string videoElementId = "attendanceCameraVideo";
    private bool isCameraActive = false;
    private bool isStartingCamera = false;
    private string? cameraErrorMessage;
    private bool showFlashEffect = false;
    private string? lastCapturedPhotoUrl;
    private string? lastCaptureTimeString;

    // Modal phóng to ảnh chấm công
    private bool showPhotoModal = false;
    private string? modalPhotoUrl;
    private string modalEmployeeName = "";
    private DateTime modalWorkDate;
    private TimeSpan? modalTime;
    private string modalActionType = "";

    // Đồng hồ thời gian thực
    private System.Threading.Timer? clockTimer;
    private string currentTimeString = DateTime.Now.ToString("HH:mm:ss");
    private string currentDateString = DateTime.Now.ToString("dd/MM/yyyy");

    public class CameraCaptureResult
    {
        public bool Success { get; set; }
        public string? DataUrl { get; set; }
        public string? Error { get; set; }
        public bool IsRealCamera { get; set; }
    }

    public class CameraInitResult
    {
        public bool Success { get; set; }
        public string? Error { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        DraftService.OnChange += StateHasChanged;
        UserSession.OnChange += StateHasChanged;
        Navigation.LocationChanged += HandleLocationChanged;
        employeeList = (await EmployeeRepo.GetAllEmployeesAsync()).ToList();

        // Khởi động đồng hồ thời gian thực
        clockTimer = new System.Threading.Timer(_ =>
        {
            currentTimeString = DateTime.Now.ToString("HH:mm:ss");
            currentDateString = DateTime.Now.ToString("dd/MM/yyyy");
            InvokeAsync(StateHasChanged);
        }, null, 0, 1000);

        await ReloadDataAsync();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        // KHÔNG tự động bật camera khi mở trang - chỉ bật khi bấm Vào ca / Hết ca
        return Task.CompletedTask;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Tắt camera ngay khi người dùng chuyển hướng sang trang khác
        _ = StopCameraAsync();
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
        DraftService.OnChange -= StateHasChanged;
        UserSession.OnChange -= StateHasChanged;
        clockTimer?.Dispose();
        _ = StopCameraAsync();
    }

    private async Task StartCameraAsync()
    {
        if (isStartingCamera) return;
        isStartingCamera = true;
        cameraErrorMessage = null;
        StateHasChanged();

        try
        {
            var res = await JSRuntime.InvokeAsync<CameraInitResult>("cameraInterop.startCamera", videoElementId);
            if (res != null && res.Success)
            {
                isCameraActive = true;
                cameraErrorMessage = null;
            }
            else
            {
                isCameraActive = false;
                cameraErrorMessage = res?.Error ?? "Không thể kết nối Camera.";
            }
        }
        catch (Exception ex)
        {
            isCameraActive = false;
            cameraErrorMessage = ex.Message;
        }
        finally
        {
            isStartingCamera = false;
            StateHasChanged();
        }
    }

    private async Task StopCameraAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("cameraInterop.stopCamera", videoElementId);
            isCameraActive = false;
        }
        catch { }
    }

    private async Task ReloadDataAsync()
    {
        if (UserSession.IsAdminHr)
        {
            await LoadPendingAttendancesAsync();
            if (!DraftService.DraftItems.Any())
            {
                await DraftService.InitializeDraftForMonthAsync(selectedMonth, selectedYear);
            }
        }
        else
        {
            await LoadPersonalAttendanceAsync();
        }
    }

    private void SetAdminTab(string tab)
    {
        activeAdminTab = tab;
    }

    private async Task LoadPendingAttendancesAsync()
    {
        pendingAttendances = await DraftService.GetPendingAttendancesAsync();
    }

    private async Task LoadPersonalAttendanceAsync()
    {
        if (UserSession.CurrentEmployeeId.HasValue)
        {
            var list = await AttendanceRepo.GetAttendancesByEmployeeAsync(
                UserSession.CurrentEmployeeId.Value, 
                selectedMonth, 
                selectedYear
            );
            personalAttendances = list.ToList();
            
            // Cập nhật ảnh chụp gần nhất nếu có
            var latestWithPhoto = personalAttendances
                .OrderByDescending(x => x.WorkDate)
                .ThenByDescending(x => x.CheckIn)
                .FirstOrDefault(x => !string.IsNullOrEmpty(x.PhotoPath) || !string.IsNullOrEmpty(x.CheckOutPhotoPath));

            if (latestWithPhoto != null && string.IsNullOrEmpty(lastCapturedPhotoUrl))
            {
                lastCapturedPhotoUrl = latestWithPhoto.PhotoPath ?? latestWithPhoto.CheckOutPhotoPath;
                lastCaptureTimeString = latestWithPhoto.CheckIn?.ToString(@"hh\:mm") ?? latestWithPhoto.CheckOut?.ToString(@"hh\:mm");
            }
        }
    }

    private async Task ExecuteActionAsync(bool isCheckIn)
    {
        isCheckInAction = isCheckIn;

        // Bật camera khi bấm nút Vào ca / Hết ca (nếu chưa bật)
        if (!isCameraActive)
        {
            await StartCameraAsync();
            if (!isCameraActive)
            {
                alertMessage = "Không thể kết nối Camera. Vui lòng kiểm tra quyền thiết bị hoặc kết nối.";
                isSuccessAlert = false;
                return;
            }
            // Đợi 700ms để camera khởi động và khung hình hiển thị ổn định
            await Task.Delay(700);
        }

        await SubmitFaceCheckInAsync();
    }

    private async Task SubmitFaceCheckInAsync()
    {
        if (!UserSession.CurrentEmployeeId.HasValue)
        {
            alertMessage = "Không xác định được danh tính nhân viên. Vui lòng đăng nhập lại.";
            isSuccessAlert = false;
            return;
        }

        isScanning = true;
        scanSuccess = false;
        alertMessage = null;
        showFlashEffect = true;
        StateHasChanged();

        // 1. Chụp ảnh từ camera qua JavaScript Interop
        string watermark = $"{UserSession.CurrentEmployeeCode} - {UserSession.CurrentEmployeeName} | {DateTime.Now:dd/MM/yyyy HH:mm:ss} | {(isCheckInAction ? "VÀO CA" : "HẾT CA")}";
        CameraCaptureResult? captureResult = null;
        try
        {
            captureResult = await JSRuntime.InvokeAsync<CameraCaptureResult>("cameraInterop.capturePhoto", videoElementId, watermark);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Camera capture JS error: {ex.Message}");
        }

        // Tắt hiệu ứng đèn flash sau 300ms
        await Task.Delay(300);
        showFlashEffect = false;
        StateHasChanged();

        // 2. Lưu ảnh vật lý vào thư mục wwwroot/uploads/attendance/
        string? savedPhotoUrl = null;
        if (captureResult != null && captureResult.Success && !string.IsNullOrEmpty(captureResult.DataUrl))
        {
            try
            {
                var base64Data = captureResult.DataUrl;
                var commaIndex = base64Data.IndexOf(',');
                if (commaIndex >= 0)
                {
                    base64Data = base64Data.Substring(commaIndex + 1);
                }

                byte[] imageBytes = Convert.FromBase64String(base64Data);
                var uploadsFolder = Path.Combine(WebHostEnvironment.WebRootPath, "uploads", "attendance");
                if (!Directory.Exists(uploadsFolder))
                {
                    Directory.CreateDirectory(uploadsFolder);
                }

                var fileName = $"att_{UserSession.CurrentEmployeeId.Value}_{DateTime.Now:yyyyMMdd_HHmmss}_{(isCheckInAction ? "in" : "out")}.jpg";
                var filePath = Path.Combine(uploadsFolder, fileName);
                await File.WriteAllBytesAsync(filePath, imageBytes);

                savedPhotoUrl = $"/uploads/attendance/{fileName}";
                lastCapturedPhotoUrl = savedPhotoUrl;
                lastCaptureTimeString = DateTime.Now.ToString("HH:mm:ss");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error saving attendance photo: {ex.Message}");
            }
        }

        // Giả lập quét AI nhận diện sinh trắc học
        await Task.Delay(500);

        var now = DateTime.Now;
        var checkTime = now.TimeOfDay;
        string shiftName = selectedShiftId switch {
            2 => "Ca Sáng",
            3 => "Ca Chiều",
            _ => "Ca Hành Chính"
        };
        string fullNote = $"Face ID AI ({shiftName}) • WiFi TechCorp_Office_5G" + 
            (!string.IsNullOrWhiteSpace(employeeCheckInNote) ? $" • {employeeCheckInNote.Trim()}" : "");

        await DraftService.SubmitFaceAttendanceAsync(
            UserSession.CurrentEmployeeId.Value,
            DateTime.Today,
            checkTime,
            isCheckInAction,
            fullNote,
            savedPhotoUrl,
            selectedShiftId
        );

        isScanning = false;
        scanSuccess = true;
        isSuccessAlert = true;
        alertMessage = $"Chấm công {(isCheckInAction ? "Vào ca" : "Hết ca")} [{shiftName}] lúc {checkTime:hh\\:mm\\:ss} thành công! Ảnh chụp đã được gửi cho Quản trị viên duyệt.";

        employeeCheckInNote = "";
        await LoadPersonalAttendanceAsync();
    }

