    }
    .status-dot-emerald {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background-color: #10b981;
        display: inline-block;
        animation: pulseEmerald 1.5s infinite;
    }
    @@keyframes pulseEmerald {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 5px rgba(16, 185, 129, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }
    .camera-viewport-box {
        background: radial-gradient(circle at center, #1e293b 0%, #0b1329 100%);
        aspect-ratio: 16 / 10;
        border-radius: 18px;
        border: 1px solid #334155;
        box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.4);
    }
    .camera-live-video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transform: scaleX(-1); /* Gương tự nhiên cho webcam */
    }
    .camera-off-backdrop {
        background: radial-gradient(circle at center, rgba(30, 41, 59, 0.85) 0%, rgba(11, 19, 41, 0.96) 100%);
        backdrop-filter: blur(4px);
    }

    /* 4 Corner L-Brackets */
    .hud-corner {
        position: absolute;
        width: 26px;
        height: 26px;
        border-color: #38bdf8;
        border-style: solid;
        pointer-events: none;
        z-index: 3;
    }
    .hud-corner-tl {
        top: 16px;
        left: 16px;
        border-width: 3.5px 0 0 3.5px;
        border-top-left-radius: 6px;
    }
    .hud-corner-tr {
        top: 16px;
        right: 16px;
        border-width: 3.5px 3.5px 0 0;
        border-top-right-radius: 6px;
    }
    .hud-corner-bl {
        bottom: 16px;
        left: 16px;
        border-width: 0 0 3.5px 3.5px;
        border-bottom-left-radius: 6px;
    }
    .hud-corner-br {
        bottom: 16px;
