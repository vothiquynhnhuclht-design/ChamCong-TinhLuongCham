    private IEnumerable<AttendanceDraftItemDto> GetFilteredItems()
    {
        var query = DraftService.DraftItems.AsEnumerable();
        if (UserSession.IsEmployee && UserSession.CurrentEmployeeId.HasValue)
        {
            query = query.Where(x => x.EmployeeId == UserSession.CurrentEmployeeId.Value);
        }
        else if (filterEmployeeId > 0)
        {
            query = query.Where(x => x.EmployeeId == filterEmployeeId);
        }
        if (!string.IsNullOrEmpty(filterStatus))
        {
            if (Enum.TryParse<AttendanceStatus>(filterStatus, out var status))
            {
                query = query.Where(x => x.Status == status);
            }
        }
        return query;
    }

    private void OnWorkDaysChanged(AttendanceDraftItemDto item, ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out double val))
        {
            item.ActualWorkDays = val;
            if (val == 0) item.Status = AttendanceStatus.Absent;
            else if (item.LateMinutes > 0) item.Status = AttendanceStatus.Late;
            else item.Status = AttendanceStatus.Present;
        }
    }

    private void OnOtChanged(AttendanceDraftItemDto item, ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out double val))
        {
            item.OvertimeHours = val;
        }
    }

