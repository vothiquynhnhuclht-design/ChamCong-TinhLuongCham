    private record CalendarDayDto(int Day, bool IsEmpty, bool IsToday, string Status);

    private List<CalendarDayDto> GetCalendarDays()
    {
        var list = new List<CalendarDayDto>();
        int daysInMonth = DateTime.DaysInMonth(selectedYear, selectedMonth);
        var firstOfMonth = new DateTime(selectedYear, selectedMonth, 1);
        int emptyOffset = ((int)firstOfMonth.DayOfWeek + 6) % 7; // Thứ 2 = 0

        for (int i = 0; i < emptyOffset; i++)
        {
            list.Add(new CalendarDayDto(0, true, false, "none"));
        }

        DateTime today = DateTime.Today;
        bool isCurrentMonth = (today.Month == selectedMonth && today.Year == selectedYear);

        for (int d = 1; d <= daysInMonth; d++)
        {
            var date = new DateTime(selectedYear, selectedMonth, d);
            bool isToday = isCurrentMonth && (d == today.Day);
            var att = personalAttendances.FirstOrDefault(a => a.WorkDate.Date == date.Date);
            string status = "none";
            bool isWeekend = (date.DayOfWeek == DayOfWeek.Saturday || date.DayOfWeek == DayOfWeek.Sunday);

            if (att != null)
            {
                if (att.Status == AttendanceStatus.Absent)
                {
                    status = "absent"; // Chấm đỏ: Nghỉ làm
                }
                else if (att.LateMinutes > 0 || att.Status == AttendanceStatus.Late)
                {
                    status = "late"; // Chấm vàng: Đi trễ
                }
                else if (att.ActualWorkDays > 0 || att.Status == AttendanceStatus.Present || att.Status == AttendanceStatus.PendingApproval)
                {
                    status = "on-time"; // Chấm xanh: Đúng giờ
                }
            }
            else if (!isWeekend)
            {
                // Ngày trong tuần (Thứ 2 đến Thứ 6)
                if (date < today)
                {
                    // Ngày trong quá khứ không đi làm -> Chấm đỏ: Nghỉ làm
                    status = "absent";
                }
                else
                {
                    // Hôm nay hoặc tương lai chưa có dữ liệu chấm công
                    status = "none";
                }
            }

            list.Add(new CalendarDayDto(d, false, isToday, status));
        }
        return list;
    }
