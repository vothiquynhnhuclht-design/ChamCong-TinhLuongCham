@if (showCreateLeaveModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.45); backdrop-filter: blur(2px); z-index: 1055;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                
                <div class="modal-header bg-slate-50 border-bottom px-4 py-3">
                    <div>
                        <h5 class="modal-title fw-bold text-slate-900 fs-6">Tạo Đơn Xin Nghỉ Phép</h5>
                        <p class="text-muted small mb-0" style="font-size: 12px;">Đơn xin nghỉ sẽ được gửi trực tiếp tới Bộ phận Nhân sự để xét duyệt.</p>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseCreateLeaveModal"></button>
                </div>

                <div class="modal-body p-4 space-y-3">
                    @if (!string.IsNullOrEmpty(formLeaveError))
                    {
                        <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3">
                            <i class="bi bi-exclamation-circle me-1"></i>@formLeaveError
                        </div>
                    }

                    <!-- 1. Loại nghỉ phép -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-slate-700 mb-1">Loại nghỉ phép <span class="text-danger">*</span></label>
                        <select class="form-select text-sm rounded-3" @bind="modalLeaveType">
                            <option value="@LeaveType.Paid">Nghỉ phép năm (Có hưởng lương - Hạn mức khả dụng)</option>
                            <option value="@LeaveType.Unpaid">Nghỉ việc riêng không hưởng lương</option>
                        </select>
                    </div>

                    <!-- 2. Tuỳ chọn nghỉ nửa ngày -->
                    <div class="p-2.5 rounded-3 bg-light border d-flex align-items-center justify-content-between mb-3">
                        <div>
                            <span class="small fw-semibold text-slate-800 d-block">Nghỉ nửa ngày (0.5 công)</span>
                            <span class="text-muted" style="font-size: 11px;">Áp dụng cho buổi sáng hoặc buổi chiều</span>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" role="switch" @bind="modalIsHalfDay" @bind:after="OnModalHalfDayChanged" style="cursor: pointer;">
                        </div>
                    </div>

                    <!-- 3. Khoảng ngày -->
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-slate-700 mb-1">Từ ngày <span class="text-danger">*</span></label>
                            <input type="date" class="form-control text-sm rounded-3" @bind="modalStartDate" @bind:after="CalculateModalDays" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-slate-700 mb-1">Đến ngày <span class="text-danger">*</span></label>
                            <input type="date" class="form-control text-sm rounded-3" @bind="modalEndDate" @bind:after="CalculateModalDays" disabled="@modalIsHalfDay" />
                        </div>
                    </div>

                    <!-- 4. Số công ước tính -->
                    <div class="p-2.5 rounded-3 bg-primary-subtle text-primary border border-primary-subtle d-flex justify-content-between align-items-center small mb-3">
                        <span class="fw-medium">Thời lượng đăng ký nghỉ:</span>
                        <span class="fw-bold fs-6">@modalCalculatedDays.ToString("0.#") công</span>
                    </div>

                    <!-- 5. Lý do -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-slate-700 mb-1">Lý do xin nghỉ <span class="text-danger">*</span></label>
                        <textarea class="form-control text-sm rounded-3" rows="3" placeholder="Nhập chi tiết lý do xin nghỉ (giải quyết việc gia đình, khám bệnh...)" @bind="modalReason"></textarea>
                    </div>

                    <!-- 6. Người duyệt chỉ định -->
                    <div class="p-2.5 rounded-3 bg-slate-50 border d-flex align-items-center gap-2.5">
                        <div class="rounded-circle bg-primary text-white fw-bold d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 11px;">
                            TB
                        </div>
                        <div class="overflow-hidden">
                            <div class="fw-bold text-slate-900 small text-truncate">Trần Thị Bình (HR Manager)</div>
                            <div class="text-muted" style="font-size: 11px;">Quản lý trực tiếp phê duyệt</div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-slate-50 border-top px-4 py-2.5 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-light border fw-semibold rounded-3 px-3" @onclick="CloseCreateLeaveModal">Hủy bỏ</button>
                    <button type="button" class="btn btn-primary fw-semibold rounded-3 px-4 shadow-xs" @onclick="SubmitModalLeaveRequestAsync">
                        <i class="bi bi-send me-1"></i>Gửi đơn duyệt
                    </button>
                </div>

            </div>
        </div>
    </div>
}

