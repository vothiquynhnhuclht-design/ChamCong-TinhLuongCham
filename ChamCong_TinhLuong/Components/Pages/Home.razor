@code {
    private string viewMode = "Employee";
    private Employee? currentEmployee;
    private DateTime selectedDate = DateTime.Today;
    private List<DateTime> currentWeekDays = new();
    private List<TimeAttendance> employeeAttendances = new();
    private TimeAttendance? currentDayAttendance;

    // Admin metrics
    private int totalEmployees = 0;
    private decimal totalNetSalary = 0;
    private decimal totalDeductions = 0;

    // Modal Đơn xin nghỉ phép
    private bool showCreateLeaveModal = false;
    private LeaveType modalLeaveType = LeaveType.Paid;
    private bool modalIsHalfDay = false;
    private DateTime modalStartDate = DateTime.Today;
    private DateTime modalEndDate = DateTime.Today;
    private double modalCalculatedDays = 1.0;
    private string modalReason = "";
    private string? formLeaveError;
    private string? alertSuccessMessage;

    protected override async Task OnInitializedAsync()
    {
        if (UserSession.IsEmployee)
        {
            viewMode = "Employee";
        }

        await LoadEmployeeDataAsync();
        BuildWeekDays();
        await LoadAttendanceDataAsync();

        if (UserSession.IsAdminHr)
        {
            var allEmps = await EmployeeRepo.GetAllEmployeesAsync();
            totalEmployees = allEmps.Count();
            var payslips = (await PayslipRepo.GetPayslipsByPeriodAsync(10, 2026)).ToList();
            if (payslips.Any())
            {
                totalNetSalary = payslips.Sum(p => p.NetSalary);
                totalDeductions = payslips.Sum(p => p.TotalDeductions);
            }
        }

        UserSession.OnChange += OnSessionChanged;
    }

    private async Task LoadEmployeeDataAsync()
    {
        if (UserSession.CurrentEmployeeId.HasValue)
        {
            currentEmployee = await EmployeeRepo.GetEmployeeByIdAsync(UserSession.CurrentEmployeeId.Value);
        }

        if (currentEmployee == null)
        {
            var all = (await EmployeeRepo.GetAllEmployeesAsync()).ToList();
            if (!string.IsNullOrEmpty(UserSession.CurrentEmployeeCode))
            {
                currentEmployee = all.FirstOrDefault(e => e.EmployeeCode.Equals(UserSession.CurrentEmployeeCode, StringComparison.OrdinalIgnoreCase));
            }
            currentEmployee ??= all.FirstOrDefault();
        }
    }

    private void BuildWeekDays()
    {
        int diff = (7 + (selectedDate.DayOfWeek - DayOfWeek.Monday)) % 7;
        DateTime monday = selectedDate.AddDays(-diff).Date;

        currentWeekDays = Enumerable.Range(0, 7)
            .Select(i => monday.AddDays(i))
            .ToList();
    }

    private async Task LoadAttendanceDataAsync()
    {
        if (currentEmployee != null)
        {
            employeeAttendances = (await AttendanceRepo.GetAttendancesByEmployeeAsync(
                currentEmployee.Id, 
                selectedDate.Month, 
                selectedDate.Year)).ToList();

            currentDayAttendance = employeeAttendances.FirstOrDefault(a => a.WorkDate.Date == selectedDate.Date);
        }
    }

    private async Task SelectDay(DateTime day)
    {
        selectedDate = day;
        currentDayAttendance = employeeAttendances.FirstOrDefault(a => a.WorkDate.Date == selectedDate.Date);
        await Task.CompletedTask;
    }

    private async Task GoPreviousDay()
    {
        selectedDate = selectedDate.AddDays(-1);
        BuildWeekDays();
        await LoadAttendanceDataAsync();
    }

    private async Task GoNextDay()
    {
        selectedDate = selectedDate.AddDays(1);
        BuildWeekDays();
        await LoadAttendanceDataAsync();
    }

    private string GetVietnameseDayName(DateTime date)
    {
        return date.DayOfWeek switch
        {
            DayOfWeek.Monday => "Thứ 2",
            DayOfWeek.Tuesday => "Thứ 3",
            DayOfWeek.Wednesday => "Thứ 4",
            DayOfWeek.Thursday => "Thứ 5",
            DayOfWeek.Friday => "Thứ 6",
            DayOfWeek.Saturday => "Thứ 7",
            DayOfWeek.Sunday => "Chủ nhật",
            _ => ""
        };
    }

    // Modal Tạo đơn nghỉ phép
    private void OpenCreateLeaveModal()
    {
        modalStartDate = DateTime.Today;
        modalEndDate = DateTime.Today;
        modalIsHalfDay = false;
        modalReason = "";
        formLeaveError = null;
        CalculateModalDays();
        showCreateLeaveModal = true;
    }

    private void CloseCreateLeaveModal()
    {
        showCreateLeaveModal = false;
    }

    private void OnModalHalfDayChanged()
    {
        if (modalIsHalfDay)
        {
            modalEndDate = modalStartDate;
            modalCalculatedDays = 0.5;
        }
        else
        {
            CalculateModalDays();
        }
    }

    private void CalculateModalDays()
    {
        if (modalIsHalfDay)
        {
            modalEndDate = modalStartDate;
            modalCalculatedDays = 0.5;
            return;
        }

        if (modalEndDate < modalStartDate)
        {
            modalCalculatedDays = 0;
            return;
        }

        int count = 0;
        var cur = modalStartDate.Date;
        while (cur <= modalEndDate.Date)
        {
            if (cur.DayOfWeek != DayOfWeek.Saturday && cur.DayOfWeek != DayOfWeek.Sunday)
            {
                count++;
            }
            cur = cur.AddDays(1);
        }
        modalCalculatedDays = count;
    }

    private async Task SubmitModalLeaveRequestAsync()
    {
        formLeaveError = null;
        if (string.IsNullOrWhiteSpace(modalReason))
        {
            formLeaveError = "Vui lòng nhập lý do xin nghỉ phép.";
            return;
        }

        if (modalCalculatedDays <= 0)
        {
            formLeaveError = "Khoảng thời gian nghỉ không hợp lệ.";
            return;
        }

        int empId = currentEmployee?.Id ?? (UserSession.CurrentEmployeeId ?? 1);

        var request = new LeaveRequest
        {
            EmployeeId = empId,
            StartDate = modalStartDate.Date,
            EndDate = modalIsHalfDay ? modalStartDate.Date : modalEndDate.Date,
            NumberOfDays = modalCalculatedDays,
            LeaveType = modalLeaveType,
            Reason = modalReason.Trim(),
            Status = LeaveRequestStatus.Pending,
            ApprovedBy = "Trần Thị Bình (HR Manager)",
            CreatedAt = DateTime.Now
        };

        await LeaveRepo.AddLeaveRequestAsync(request);
        alertSuccessMessage = $"Đơn xin nghỉ phép ({modalCalculatedDays} ngày) đã được gửi thành công đến Quản lý / HR xét duyệt!";
        
        CloseCreateLeaveModal();
    }

    private async void OnSessionChanged()
    {
        await LoadEmployeeDataAsync();
        await LoadAttendanceDataAsync();
        StateHasChanged();
    }

    public void Dispose()
    {
        UserSession.OnChange -= OnSessionChanged;
    }
}
