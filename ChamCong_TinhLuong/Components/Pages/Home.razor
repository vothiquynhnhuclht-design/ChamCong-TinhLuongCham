@page "/"
@inject IEmployeeRepository EmployeeRepo
@inject IAttendanceRepository AttendanceRepo
@inject IDepartmentRepository DepartmentRepo
@inject IPayslipRepository PayslipRepo
@inject UserSessionService UserSession
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Tổng Quan - HRM Enterprise</PageTitle>

<div class="dashboard-employee-wrapper py-2">

    @if (UserSession.IsAdminHr)
    {
        <!-- Chuyển đổi góc nhìn dành cho Quản trị viên / Kiểm thử đồ án -->
        <div class="d-flex align-items-center justify-content-between p-2.5 px-3 mb-3 bg-white border rounded-3 shadow-2xs">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                    <i class="bi bi-shield-check me-1"></i>Tài khoản Quản trị
                </span>
                <span class="text-muted small">Bạn đang xem giao diện Tổng quan theo phân quyền:</span>
            </div>
            <div class="btn-group btn-group-sm" role="group">
                <button type="button" class="btn @(viewMode == "Employee" ? "btn-primary" : "btn-outline-secondary") px-3 fw-semibold" @onclick='() => viewMode = "Employee"'>
                    <i class="bi bi-person me-1"></i>Giao diện Nhân viên
                </button>
                <button type="button" class="btn @(viewMode == "Admin" ? "btn-primary" : "btn-outline-secondary") px-3 fw-semibold" @onclick='() => viewMode = "Admin"'>
                    <i class="bi bi-bar-chart-steps me-1"></i>Giao diện Quản trị / HR
                </button>
            </div>
        </div>
    }

    @if (viewMode == "Employee" || UserSession.IsEmployee)
    {
        <!-- ========================================================================================= -->
        <!-- GIAO DIỆN TỔNG QUAN PHÂN QUYỀN NHÂN VIÊN (CHUẨN 100% THEO THIẾT KẾ ĐẶC TẢ) -->
        <!-- ========================================================================================= -->

        <!-- 1. BANNER CHÀO MỪNG (GREETING BANNER) -->
        <div class="card border-0 rounded-4 mb-4 overflow-hidden shadow-xs welcome-employee-banner">
            <div class="card-body p-4 p-lg-4 d-flex align-items-center justify-content-between position-relative">
                <div class="z-1">
                    <h2 class="fw-bolder text-slate-900 mb-1.5 tracking-tight banner-greeting-title">
                        Xin chào, @(string.IsNullOrEmpty(currentEmployee?.FullName) ? (string.IsNullOrEmpty(UserSession.CurrentEmployeeName) ? "Nguyễn Thị Mai" : UserSession.CurrentEmployeeName) : currentEmployee.FullName)!
                    </h2>
                    <p class="text-slate-500 mb-0 small fs-6">
                        Chúc bạn một ngày làm việc hiệu quả và nhiều năng lượng!
                    </p>
                </div>

                <!-- Vector Illustration (Woman working at desk with laptop and plant) -->
                <div class="welcome-employee-art d-none d-md-block pe-lg-3">
                    <svg width="220" height="110" viewBox="0 0 220 110" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="150" cy="55" r="45" fill="#F1F5F9" opacity="0.8" />
                        <!-- Plant -->
                        <path d="M185 85C185 68 193 60 198 56C203 60 211 68 211 85" fill="#38BDF8" opacity="0.7" />
                        <line x1="198" y1="56" x2="198" y2="85" stroke="#0284C7" stroke-width="2" />
                        <!-- Desk -->
                        <rect x="55" y="86" width="145" height="4" rx="2" fill="#CBD5E1" />
                        <!-- Character Body -->
                        <path d="M115 65C115 52 125 46 135 46C145 46 155 52 155 65L160 86H110L115 65Z" fill="#3B82F6" />
                        <!-- Head & Hair -->
                        <circle cx="135" cy="33" r="11" fill="#FBD5BD" />
                        <path d="M126 31C126 21 132 17 138 17C146 17 148 23 146 31C143 29 138 29 134 33Z" fill="#1E293B" />
                        <path d="M126 31C124 39 126 47 130 51" stroke="#1E293B" stroke-width="4" stroke-linecap="round" />
                        <!-- Laptop -->
                        <rect x="125" y="73" width="28" height="13" rx="2" fill="#0F172A" />
                        <rect x="128" y="75" width="22" height="9" rx="1" fill="#BAE6FD" />
                        <line x1="120" y1="86" x2="158" y2="86" stroke="#64748B" stroke-width="2.5" stroke-linecap="round" />
                        <!-- Floating Soft Lilac Circles -->
                        <circle cx="50" cy="40" r="14" fill="#E9D5FF" opacity="0.6" />
                        <circle cx="75" cy="25" r="7" fill="#FBCFE8" opacity="0.6" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- 2. BA THẺ THAO TÁC NHANH (3 QUICK ACCESS CARDS) -->
        <div class="row g-3 mb-4">
            <!-- Card 1: Chấm công -->
            <div class="col-12 col-md-4">
                <div class="card border-0 shadow-xs rounded-4 bg-white p-3.5 quick-action-card h-100 cursor-pointer" @onclick='() => Navigation.NavigateTo("/attendance")'>
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="action-icon-box bg-blue-50 text-primary">
                                <i class="bi bi-clock"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold text-slate-900 mb-0.5 action-card-title">Chấm công</h6>
                                <p class="text-slate-400 small mb-0" style="font-size: 12.5px;">Xem lịch làm việc, check-in/out</p>
                            </div>
                        </div>
                        <i class="bi bi-arrow-right text-slate-400 fs-5 action-arrow"></i>
                    </div>
                </div>
            </div>

            <!-- Card 2: Đơn xin nghỉ phép -->
            <div class="col-12 col-md-4">
                <div class="card border-0 shadow-xs rounded-4 bg-white p-3.5 quick-action-card h-100 cursor-pointer" @onclick='() => Navigation.NavigateTo("/attendance")'>
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="action-icon-box bg-purple-50 text-purple-600">
                                <i class="bi bi-file-earmark-text"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold text-slate-900 mb-0.5 action-card-title">Đơn xin nghỉ phép</h6>
                                <p class="text-slate-400 small mb-0" style="font-size: 12.5px;">Tạo đơn nghỉ, theo dõi trạng thái</p>
                            </div>
                        </div>
                        <i class="bi bi-arrow-right text-slate-400 fs-5 action-arrow"></i>
                    </div>
                </div>
            </div>

            <!-- Card 3: Xem bảng lương -->
            <div class="col-12 col-md-4">
                <div class="card border-0 shadow-xs rounded-4 bg-white p-3.5 quick-action-card h-100 cursor-pointer" @onclick='() => Navigation.NavigateTo("/payroll")'>
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="action-icon-box bg-emerald-50 text-emerald-600">
                                <i class="bi bi-file-earmark-spreadsheet"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold text-slate-900 mb-0.5 action-card-title">Xem bảng lương</h6>
                                <p class="text-slate-400 small mb-0" style="font-size: 12.5px;">Xem thông tin lương, phúc lợi</p>
                            </div>
                        </div>
                        <i class="bi bi-arrow-right text-slate-400 fs-5 action-arrow"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. KHU VỰC NỘI DUNG CHÍNH (8 CỘT TRÁI - 4 CỘT PHẢI) -->
        <div class="row g-4 mb-4">
            
            <!-- CỘT TRÁI (8 CỘT): LỊCH LÀM VIỆC CỦA TÔI & CHÂM NGÔN -->
            <div class="col-12 col-lg-8">
                
                <!-- Card: Lịch làm việc của tôi -->
                <div class="card border-0 shadow-xs rounded-4 bg-white mb-4 overflow-hidden schedule-main-card">
                    <!-- Header -->
                    <div class="card-header bg-white border-bottom py-3 px-4 d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-calendar-event text-primary fs-5"></i>
                            <h5 class="fw-bold text-slate-900 mb-0 fs-6">Lịch làm việc của tôi</h5>
                        </div>

                        <!-- Date Picker / Navigation -->
                        <div class="d-flex align-items-center gap-1.5">
                            <span class="badge bg-light text-slate-700 border px-3 py-1.5 rounded-3 fw-medium d-flex align-items-center gap-1.5" style="font-size: 12px;">
                                <i class="bi bi-calendar3 text-primary"></i>
                                <span>@GetVietnameseDayName(selectedDate), @selectedDate.ToString("dd/MM/yyyy")</span>
                            </span>
                            <button class="btn btn-sm btn-light border p-1 px-2 rounded-2 text-slate-600" title="Ngày trước" @onclick="GoPreviousDay">
                                <i class="bi bi-chevron-left" style="font-size: 11px;"></i>
                            </button>
                            <button class="btn btn-sm btn-light border p-1 px-2 rounded-2 text-slate-600" title="Ngày kế tiếp" @onclick="GoNextDay">
                                <i class="bi bi-chevron-right" style="font-size: 11px;"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Card Body (Chia 2 cột: Danh sách 7 ngày bên trái & Timeline bên phải) -->
                    <div class="card-body p-0">
                        <div class="row g-0">
                            
                            <!-- Danh sách 7 ngày trong tuần (Trái: 35%) -->
                            <div class="col-12 col-md-5 col-lg-4 border-end bg-slate-50/50 p-2.5">
                                <div class="d-flex flex-column gap-1.5">
                                    @foreach (var day in currentWeekDays)
                                    {
                                        bool isSelected = day.Date == selectedDate.Date;
                                        bool isWeekend = day.DayOfWeek == DayOfWeek.Saturday || day.DayOfWeek == DayOfWeek.Sunday;

                                        <div class="schedule-day-item p-2.5 rounded-3 d-flex align-items-center justify-content-between cursor-pointer @(isSelected ? "day-item-active" : "")"
                                             @onclick="() => SelectDay(day)">
                                            <div class="d-flex align-items-center gap-2.5">
                                                <i class="bi bi-calendar @(isSelected ? "text-primary" : "text-slate-400")" style="font-size: 14px;"></i>
                                                <div>
                                                    <div class="fw-bold @(isSelected ? "text-primary" : "text-slate-800")" style="font-size: 12.5px;">
                                                        @GetVietnameseDayName(day)
                                                    </div>
                                                    <div class="text-slate-400" style="font-size: 11px;">
                                                        @day.ToString("dd/MM/yyyy")
                                                    </div>
                                                </div>
                                            </div>
                                            @if (isSelected)
                                            {
                                                <span class="day-active-pill"></span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Timeline chi tiết ngày được chọn (Phải: 65%) -->
                            <div class="col-12 col-md-7 col-lg-8 p-4">
                                @if (selectedDate.DayOfWeek == DayOfWeek.Saturday || selectedDate.DayOfWeek == DayOfWeek.Sunday)
                                {
                                    <div class="p-4 text-center text-muted my-4">
                                        <i class="bi bi-cup-hot fs-1 text-slate-300 d-block mb-2"></i>
                                        <h6 class="fw-bold text-slate-700 mb-1">Nghỉ cuối tuần</h6>
                                        <p class="small text-slate-400 mb-0">Hôm nay là ngày nghỉ định kỳ theo quy chế làm việc của công ty.</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="schedule-timeline position-relative ps-3">
                                        
                                        <!-- Slot 1: Ca Sáng (08:00 - 12:00) -->
                                        <div class="timeline-slot-item mb-4 position-relative">
                                            <div class="timeline-time-badge fw-bold text-slate-700">08:00 - 12:00</div>
                                            <div class="timeline-content-box mt-1.5 p-2.5 rounded-3 bg-slate-50 border border-slate-100">
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="status-circle-dot bg-primary"></span>
                                                    <span class="fw-bold text-slate-900 small">Làm việc tại văn phòng</span>
                                                </div>
                                                <div class="text-slate-400 small mt-1 ms-3.5" style="font-size: 11.5px;">
                                                    <i class="bi bi-geo-alt me-1"></i>@(currentEmployee?.Department?.DepartmentName ?? "Phòng Kinh doanh")
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Slot 2: Nghỉ trưa (12:00 - 13:00) -->
                                        <div class="timeline-slot-item mb-4 position-relative">
                                            <div class="timeline-time-badge fw-bold text-slate-700">12:00 - 13:00</div>
                                            <div class="timeline-content-box mt-1.5 p-2.5 rounded-3 bg-slate-50 border border-slate-100">
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="status-circle-dot bg-emerald-500"></span>
                                                    <span class="fw-bold text-slate-900 small">Nghỉ trưa</span>
                                                </div>
                                                <div class="text-slate-400 small mt-1 ms-3.5" style="font-size: 11.5px;">
                                                    <i class="bi bi-cup-straw me-1"></i>Căn tin công ty
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Slot 3: Ca Chiều (13:00 - 17:00) -->
                                        <div class="timeline-slot-item position-relative">
                                            <div class="timeline-time-badge fw-bold text-slate-700">13:00 - 17:00</div>
                                            <div class="timeline-content-box mt-1.5 p-2.5 rounded-3 bg-slate-50 border border-slate-100">
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="status-circle-dot bg-purple-600"></span>
                                                    <span class="fw-bold text-slate-900 small">Làm việc tại văn phòng</span>
                                                </div>
                                                <div class="text-slate-400 small mt-1 ms-3.5" style="font-size: 11.5px;">
                                                    <i class="bi bi-geo-alt me-1"></i>@(currentEmployee?.Department?.DepartmentName ?? "Phòng Kinh doanh")
                                                </div>
                                            </div>
                                        </div>

                                    </div>

                                    @if (currentDayAttendance != null)
                                    {
                                        <div class="mt-4 p-2.5 rounded-3 bg-emerald-50 border border-emerald-200 text-emerald-800 d-flex align-items-center justify-content-between small">
                                            <span>
                                                <i class="bi bi-check-circle-fill me-1 text-emerald-600"></i>
                                                Đã chấm công: Vào <strong>@(currentDayAttendance.CheckIn.HasValue ? currentDayAttendance.CheckIn.Value.ToString(@"hh\:mm") : "0")</strong> 
                                                - Ra <strong>@(currentDayAttendance.CheckOut.HasValue ? currentDayAttendance.CheckOut.Value.ToString(@"hh\:mm") : "0")</strong>
                                            </span>
                                            <span class="badge bg-emerald-600 text-white">@currentDayAttendance.ActualWorkDays.ToString("0.#") công</span>
                                        </div>
                                    }
                                }
                            </div>

                        </div>
                    </div>
                </div>

                <!-- Card: Châm ngôn tạo động lực (Motivation Quote Card) -->
                <div class="card border-0 rounded-4 overflow-hidden quote-motivation-card p-3 p-md-3.5 shadow-xs">
                    <div class="d-flex align-items-center gap-3">
                        <div class="quote-graphic-icon flex-shrink-0">
                            <!-- 3D Calendar/Clock icon vector -->
                            <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
                                <rect x="6" y="10" width="36" height="32" rx="8" fill="#F87171" />
                                <rect x="6" y="10" width="36" height="12" rx="8" fill="#EF4444" />
                                <circle cx="16" cy="7" r="2.5" fill="#CBD5E1" />
                                <circle cx="32" cy="7" r="2.5" fill="#CBD5E1" />
                                <circle cx="34" cy="34" r="10" fill="#3B82F6" stroke="#FFFFFF" stroke-width="2" />
                                <path d="M34 28V34L38 36" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" />
                            </svg>
                        </div>
                        <div class="flex-grow-1">
                            <p class="quote-text mb-0 fw-semibold text-slate-700 fst-italic">
                                “Làm việc chăm chỉ hôm nay để chạm đến thành công ngày mai!”
                            </p>
                        </div>
                    </div>
                </div>

            </div>

            <!-- CỘT PHẢI (4 CỘT): THÔNG TIN CÁ NHÂN & THÔNG BÁO MỚI NHẤT -->
            <div class="col-12 col-lg-4">
                
                <!-- Card 1: Thông tin cá nhân -->
                <div class="card border-0 shadow-xs rounded-4 bg-white mb-4 p-4 profile-side-card">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-person text-primary fs-5"></i>
                        <h5 class="fw-bold text-slate-900 mb-0 fs-6">Thông tin cá nhân</h5>
                    </div>

                    <!-- Avatar + Name + Role Center -->
                    <div class="text-center pb-3 border-bottom">
                        <div class="profile-avatar-large mx-auto mb-2.5">
                            <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=160&auto=format&fit=crop&q=80" 
                                 alt="Avatar" class="rounded-circle shadow-xs" 
                                 style="width: 84px; height: 84px; object-fit: cover;" 
                                 onerror="this.src='https://ui-avatars.com/api/?name=Nguyen+Thi+Mai&background=0D8ABC&color=fff';" />
                        </div>
                        <h5 class="fw-bolder text-slate-900 mb-0.5">
                            @(string.IsNullOrEmpty(currentEmployee?.FullName) ? (string.IsNullOrEmpty(UserSession.CurrentEmployeeName) ? "Nguyễn Thị Mai" : UserSession.CurrentEmployeeName) : currentEmployee.FullName)
                        </h5>
                        <p class="text-slate-400 small mb-1">
                            @(string.IsNullOrEmpty(currentEmployee?.Position) ? "Nhân viên" : currentEmployee.Position)
                        </p>
                        <span class="badge bg-light text-slate-600 border px-2.5 py-1 rounded-pill" style="font-size: 11px;">
                            Mã NV: @(string.IsNullOrEmpty(currentEmployee?.EmployeeCode) ? "0" : currentEmployee.EmployeeCode)
                        </span>
                    </div>

                    <!-- Details Rows (Email, Phone, Birth/Join, Address/Dept) -->
                    <div class="py-3 d-flex flex-column gap-2.5" style="font-size: 13px;">
                        
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-slate-500 d-flex align-items-center gap-2">
                                <i class="bi bi-envelope text-slate-400"></i>Email
                            </span>
                            <span class="text-slate-800 fw-medium text-truncate ms-2" style="max-width: 170px;" title="@currentEmployee?.Email">
                                @(string.IsNullOrEmpty(currentEmployee?.Email) ? "0" : currentEmployee.Email)
                            </span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-slate-500 d-flex align-items-center gap-2">
                                <i class="bi bi-telephone text-slate-400"></i>Số điện thoại
                            </span>
                            <span class="text-slate-800 fw-medium">
                                @(string.IsNullOrEmpty(currentEmployee?.PhoneNumber) ? "0" : currentEmployee.PhoneNumber)
                            </span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-slate-500 d-flex align-items-center gap-2">
                                <i class="bi bi-calendar-check text-slate-400"></i>Ngày vào làm
                            </span>
                            <span class="text-slate-800 fw-medium">
                                @(currentEmployee != null ? currentEmployee.JoinDate.ToString("dd/MM/yyyy") : "0")
                            </span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-slate-500 d-flex align-items-center gap-2">
                                <i class="bi bi-geo-alt text-slate-400"></i>Phòng ban
                            </span>
                            <span class="text-slate-800 fw-medium text-truncate ms-2" style="max-width: 170px;" title="@currentEmployee?.Department?.DepartmentName">
                                @(currentEmployee?.Department != null ? currentEmployee.Department.DepartmentName : "123 Nguyễn Văn Cừ, Đà Nẵng")
                            </span>
                        </div>

                    </div>

                    <!-- Action Button -->
                    <div class="pt-2">
                        <button class="btn btn-outline-primary w-100 rounded-3 py-2 fw-semibold text-center d-flex align-items-center justify-content-center gap-1.5" style="font-size: 13px;" @onclick='() => Navigation.NavigateTo("/employees")'>
                            <span>Xem chi tiết</span>
                            <i class="bi bi-arrow-right"></i>
                        </button>
                    </div>
                </div>

                <!-- Card 2: Thông báo mới nhất -->
                <div class="card border-0 shadow-xs rounded-4 bg-white p-4 announcements-side-card">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-bell text-primary fs-5"></i>
                            <h5 class="fw-bold text-slate-900 mb-0 fs-6">Thông báo mới nhất</h5>
                        </div>
                        <a href="javascript:void(0)" class="text-primary text-decoration-none small fw-semibold" style="font-size: 12px;">
                            Xem tất cả <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>

                    <div class="d-flex flex-column gap-3">
                        
                        <!-- Item 1: Nghỉ lễ -->
                        <div class="announcement-item pb-2.5 border-bottom">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="status-circle-dot bg-amber-500 flex-shrink-0"></span>
                                    <span class="fw-bold text-slate-900" style="font-size: 13px;">Thông báo lịch nghỉ lễ 2/9</span>
                                </div>
                                <span class="text-slate-400" style="font-size: 11px;">25/08/2026</span>
                            </div>
                            <p class="text-slate-500 mb-0 small mt-1 ms-3.5 text-truncate" style="font-size: 12px;">
                                Công ty sẽ nghỉ lễ từ ngày 01/09 - 03/09/2026...
                            </p>
                        </div>

                        <!-- Item 2: Quy định chấm công -->
                        <div class="announcement-item pb-2.5 border-bottom">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="status-circle-dot bg-blue-600 flex-shrink-0"></span>
                                    <span class="fw-bold text-slate-900" style="font-size: 13px;">Cập nhật quy định chấm công</span>
                                </div>
                                <span class="text-slate-400" style="font-size: 11px;">20/08/2026</span>
                            </div>
                            <p class="text-slate-500 mb-0 small mt-1 ms-3.5 text-truncate" style="font-size: 12px;">
                                Vui lòng tuân thủ quy định chấm công mới từ...
                            </p>
                        </div>

                        <!-- Item 3: Đào tạo nội bộ -->
                        <div class="announcement-item">
