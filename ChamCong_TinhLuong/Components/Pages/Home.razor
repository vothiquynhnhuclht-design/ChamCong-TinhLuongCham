@code {
    private string viewMode = "Employee"; // Mặc định mở giao diện Nhân viên theo yêu cầu
    private Employee? currentEmployee;
    private DateTime selectedDate = DateTime.Today;
    private List<DateTime> currentWeekDays = new();
    private List<TimeAttendance> employeeAttendances = new();
    private TimeAttendance? currentDayAttendance;

    // Admin metrics
    private int totalEmployees = 0;
    private decimal totalNetSalary = 0;
    private decimal totalDeductions = 0;

    protected override async Task OnInitializedAsync()
    {
        // 1. Xác định chế độ hiển thị
        if (UserSession.IsEmployee)
        {
            viewMode = "Employee";
        }

        // 2. Tải thông tin nhân viên đăng nhập thực tế từ CSDL SQL Server
        await LoadEmployeeDataAsync();

        // 3. Khởi tạo danh sách 7 ngày trong tuần
        BuildWeekDays();

        // 4. Tải dữ liệu chấm công thực tế
        await LoadAttendanceDataAsync();

        // 5. Nếu là Admin, tải thêm dữ liệu tổng hợp
        if (UserSession.IsAdminHr)
        {
            var allEmps = await EmployeeRepo.GetAllEmployeesAsync();
            totalEmployees = allEmps.Count();
            var payslips = (await PayslipRepo.GetPayslipsByPeriodAsync(10, 2026)).ToList();
            if (payslips.Any())
            {
                totalNetSalary = payslips.Sum(p => p.NetSalary);
                totalDeductions = payslips.Sum(p => p.TotalDeductions);
            }
        }

        UserSession.OnChange += OnSessionChanged;
    }

    private async Task LoadEmployeeDataAsync()
    {
        if (UserSession.CurrentEmployeeId.HasValue)
        {
            currentEmployee = await EmployeeRepo.GetEmployeeByIdAsync(UserSession.CurrentEmployeeId.Value);
        }

        if (currentEmployee == null)
        {
            var all = (await EmployeeRepo.GetAllEmployeesAsync()).ToList();
            if (!string.IsNullOrEmpty(UserSession.CurrentEmployeeCode))
            {
                currentEmployee = all.FirstOrDefault(e => e.EmployeeCode.Equals(UserSession.CurrentEmployeeCode, StringComparison.OrdinalIgnoreCase));
            }
            currentEmployee ??= all.FirstOrDefault();
        }
    }

    private void BuildWeekDays()
    {
        // Lấy ngày Thứ 2 đầu tuần của selectedDate
        int diff = (7 + (selectedDate.DayOfWeek - DayOfWeek.Monday)) % 7;
        DateTime monday = selectedDate.AddDays(-diff).Date;

        currentWeekDays = Enumerable.Range(0, 7)
            .Select(i => monday.AddDays(i))
            .ToList();
    }

    private async Task LoadAttendanceDataAsync()
    {
        if (currentEmployee != null)
        {
            employeeAttendances = (await AttendanceRepo.GetAttendancesByEmployeeAsync(
                currentEmployee.Id, 
                selectedDate.Month, 
                selectedDate.Year)).ToList();

            currentDayAttendance = employeeAttendances.FirstOrDefault(a => a.WorkDate.Date == selectedDate.Date);
        }
    }

    private async Task SelectDay(DateTime day)
    {
        selectedDate = day;
        currentDayAttendance = employeeAttendances.FirstOrDefault(a => a.WorkDate.Date == selectedDate.Date);
        await Task.CompletedTask;
    }

    private async Task GoPreviousDay()
    {
        selectedDate = selectedDate.AddDays(-1);
        BuildWeekDays();
        await LoadAttendanceDataAsync();
    }

    private async Task GoNextDay()
    {
        selectedDate = selectedDate.AddDays(1);
        BuildWeekDays();
        await LoadAttendanceDataAsync();
    }

    private string GetVietnameseDayName(DateTime date)
    {
        return date.DayOfWeek switch
        {
            DayOfWeek.Monday => "Thứ 2",
            DayOfWeek.Tuesday => "Thứ 3",
            DayOfWeek.Wednesday => "Thứ 4",
            DayOfWeek.Thursday => "Thứ 5",
            DayOfWeek.Friday => "Thứ 6",
            DayOfWeek.Saturday => "Thứ 7",
            DayOfWeek.Sunday => "Chủ nhật",
            _ => ""
        };
    }

    private async void OnSessionChanged()
    {
        await LoadEmployeeDataAsync();
        await LoadAttendanceDataAsync();
        StateHasChanged();
    }

    public void Dispose()
    {
        UserSession.OnChange -= OnSessionChanged;
    }
}
