@page "/"
@inject IEmployeeRepository EmployeeRepo
@inject IPayslipRepository PayslipRepo
@inject IAttendanceRepository AttendanceRepo

<PageTitle>Tổng Quan - Hệ Thống Chấm Công & Tính Lương</PageTitle>

<div class="container-fluid py-3">
    <!-- Header Hero -->
    <div class="card border-0 shadow-sm bg-primary text-white rounded-3 mb-4 p-4">
        <div class="row align-items-center">
            <div class="col-md-8">
                <span class="badge bg-warning text-dark fw-bold mb-2">ĐỀ TÀI 17 - CAPSTONE PROJECT</span>
                <h2 class="fw-bold mb-1">Hệ Thống Chấm Công & Tính Lương Tự Động</h2>
                <p class="mb-0 text-white-50">
                    Kiến trúc Clean Architecture 4 tầng (.NET 8 Blazor Interactive Server) • Mô hình Header - Line • State Management Bảng công nháp
                </p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <a href="payroll" class="btn btn-light btn-lg fw-bold text-primary shadow-sm me-2">
                    <i class="bi bi-calculator me-1"></i> Tính Lương
                </a>
                <a href="attendance" class="btn btn-outline-light btn-lg">
                    <i class="bi bi-clock-history me-1"></i> Bảng Công
                </a>
            </div>
        </div>
    </div>

    <!-- Quick Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100 border-start border-primary border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold">Tổng Nhân Sự</span>
                        <h3 class="fw-bold text-dark mt-1 mb-0">@totalEmployees</h3>
                    </div>
                    <div class="bg-primary-subtle text-primary p-3 rounded-circle">
                        <i class="bi bi-people-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100 border-start border-success border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold">Kỳ Lương Hiện Tại</span>
                        <h3 class="fw-bold text-success mt-1 mb-0">10/2026</h3>
                    </div>
                    <div class="bg-success-subtle text-success p-3 rounded-circle">
                        <i class="bi bi-calendar-check fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100 border-start border-info border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold">Phiếu Lương Đã Tạo</span>
                        <h3 class="fw-bold text-info mt-1 mb-0">@totalPayslips</h3>
                    </div>
                    <div class="bg-info-subtle text-info p-3 rounded-circle">
                        <i class="bi bi-receipt fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100 border-start border-warning border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold">Trạng Thái Sổ Lương</span>
                        <h4 class="fw-bold mt-1 mb-0 @(isLocked ? "text-danger" : "text-warning")">
                            @(isLocked ? "Đã Khóa Sổ" : "Bản Nháp (Draft)")
                        </h4>
                    </div>
                    <div class="bg-warning-subtle text-warning p-3 rounded-circle">
                        <i class="bi @(isLocked ? "bi-lock-fill" : "bi-unlock-fill") fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Architectural Highlights -->
    <div class="card border-0 shadow-sm rounded-3 p-4 bg-white">
        <h5 class="fw-bold mb-3"><i class="bi bi-diagram-3-fill text-primary me-2"></i>Đặc Tả Tuân Thủ Chuẩn Rubric Đề Tài 17</h5>
        <div class="row g-3">
            <div class="col-md-6 col-lg-3">
                <div class="p-3 bg-light rounded-3 h-100">
                    <h6 class="fw-bold text-primary"><i class="bi bi-layers me-1"></i> Clean Architecture</h6>
                    <p class="small text-muted mb-0">4 tầng tách biệt: CoreBusiness (0 phụ thuộc), UseCases, Plugins DataStore, WebApp.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="p-3 bg-light rounded-3 h-100">
                    <h6 class="fw-bold text-success"><i class="bi bi-file-earmark-medical me-1"></i> Tách Hợp Đồng (Contract)</h6>
                    <p class="small text-muted mb-0">Lương cơ bản, phụ cấp, mức đóng BHXH nằm riêng trong Contract, hỗ trợ thay đổi theo thời gian.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="p-3 bg-light rounded-3 h-100">
                    <h6 class="fw-bold text-info"><i class="bi bi-cart-check me-1"></i> Bảng Công Nháp (State)</h6>
                    <p class="small text-muted mb-0">AttendanceDraftService (Scoped) hoạt động như Giỏ hàng, cho phép chỉnh sửa trước khi commit vào DB.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="p-3 bg-light rounded-3 h-100">
                    <h6 class="fw-bold text-danger"><i class="bi bi-shield-lock me-1"></i> 2 Luật Nghiệp Vụ Cốt Lõi</h6>
                    <p class="small text-muted mb-0">Tính lương trong Database Transaction; Khóa sổ kỳ lương và phân quyền cấp dòng (Row-Level Security).</p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private int totalEmployees = 0;
    private int totalPayslips = 0;
    private bool isLocked = false;

    protected override async Task OnInitializedAsync()
    {
        var emps = await EmployeeRepo.GetAllEmployeesAsync();
        totalEmployees = emps.Count();

        var slips = await PayslipRepo.GetPayslipsByPeriodAsync(10, 2026);
        totalPayslips = slips.Count();
        isLocked = await PayslipRepo.IsPeriodLockedAsync(10, 2026);
    }
}
