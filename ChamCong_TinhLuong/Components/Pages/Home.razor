@page "/"
@inject IEmployeeRepository EmployeeRepo
@inject IPayslipRepository PayslipRepo
@inject UserSessionService UserSession

<PageTitle>Tổng Quan - HRM Enterprise</PageTitle>

<div class="dashboard-page-wrapper py-2">
    <!-- 1. Top Welcome Banner Card -->
    <div class="card border-0 shadow-xs rounded-4 bg-white mb-4 welcome-card overflow-hidden">
        <div class="card-body p-4 p-lg-4 d-flex flex-wrap align-items-center justify-content-between gap-3 position-relative">
            <!-- Left: Greeting + Big Bold Name -->
            <div>
                <div class="d-flex align-items-center gap-2 text-slate-500 small mb-1.5 fw-medium">
                    <span class="fs-5">👋</span> Xin chào,
                    <span class="badge rounded-pill bg-emerald-50 text-emerald-700 border border-emerald-200 px-2 py-0.5 fw-semibold" style="font-size: 11px;">
                        <span class="status-dot-pulse bg-emerald-500 me-1"></span> Hệ thống đang hoạt động
                    </span>
                </div>
                <h2 class="fw-bolder text-slate-900 mb-1.5 tracking-tight welcome-user-name">
                    @(string.IsNullOrEmpty(UserSession.CurrentEmployeeName) ? "Võ Thị Quỳnh Như" : UserSession.CurrentEmployeeName)
                </h2>
                <p class="text-slate-400 small mb-0 fs-6">Chúc bạn một ngày làm việc hiệu quả và quản trị nhân sự thuận lợi!</p>
            </div>

            <!-- Middle/Right: Professional Flat Vector Art (Woman at Desk with Laptop & 3D Charts) -->
            <div class="welcome-illustration-art d-none d-md-block pe-lg-4">
                <svg width="260" height="115" viewBox="0 0 240 110" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <!-- Background Soft Glow -->
                    <circle cx="160" cy="55" r="50" fill="#EFF6FF" />
                    <!-- Desk & Plants -->
                    <rect x="70" y="85" width="130" height="4" rx="2" fill="#CBD5E1" />
                    <path d="M185 85C185 65 195 55 200 50C205 55 215 65 215 85" fill="#38BDF8" opacity="0.6" />
                    <circle cx="200" cy="45" r="5" fill="#0284C7" />
                    <!-- Character (Woman working on Laptop) -->
                    <!-- Body / Blazer -->
                    <path d="M125 65C125 50 135 45 145 45C155 45 165 50 165 65L170 85H120L125 65Z" fill="#2563EB" />
                    <!-- Inner Shirt -->
                    <path d="M140 45L145 60L150 45Z" fill="#FFFFFF" />
                    <!-- Head & Hair -->
                    <circle cx="145" cy="32" r="11" fill="#FBD5BD" />
                    <path d="M136 30C136 20 142 16 148 16C156 16 158 22 156 30C153 28 148 28 144 32Z" fill="#0F172A" />
                    <path d="M136 30C134 38 136 46 140 50" stroke="#0F172A" stroke-width="4" stroke-linecap="round" />
                    <!-- Laptop on Desk -->
                    <rect x="135" y="72" width="28" height="15" rx="2" fill="#1E293B" />
                    <rect x="138" y="74" width="22" height="10" rx="1" fill="#93C5FD" />
                    <line x1="130" y1="86" x2="168" y2="86" stroke="#64748B" stroke-width="3" stroke-linecap="round" />
                    <!-- Floating 3D Chart Bars in background -->
                    <rect x="40" y="45" width="18" height="40" rx="3" fill="#BFDBFE" opacity="0.7" />
                    <rect x="62" y="30" width="18" height="55" rx="3" fill="#93C5FD" opacity="0.8" />
                    <rect x="84" y="15" width="18" height="70" rx="3" fill="#3B82F6" />
                </svg>
            </div>

            <!-- Top Right: Period Selector Dropdown Button -->
            <div class="position-absolute top-0 end-0 p-3.5">
                <button class="btn btn-sm btn-outline-secondary bg-white text-slate-700 py-1.5 px-3 rounded-3 d-flex align-items-center gap-1.5 shadow-2xs border-slate-200 font-medium period-select-btn">
                    <i class="bi bi-calendar3 text-primary"></i>
                    <span>Kỳ lương: <strong>Tháng @selectedPeriod</strong></span>
                    <i class="bi bi-chevron-down text-slate-400 ms-1" style="font-size: 10px;"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- 2. Four KPI Metric Cards Row -->
    <div class="row g-4 mb-4">
        <!-- Card 1: Tổng nhân sự -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-xs rounded-4 bg-white p-4 kpi-card h-100">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="text-xs fw-bold text-slate-500 text-uppercase tracking-wider">Tổng nhân sự</span>
                    <div class="kpi-icon-circle bg-blue-50 text-primary">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline gap-2 mb-2">
                    <span class="kpi-number text-slate-900">@totalEmployees</span>
                    <span class="text-slate-400 small fw-medium">nhân sự</span>
                </div>
                <div class="d-flex align-items-center text-emerald-600 small fw-semibold" style="font-size: 12.5px;">
                    <i class="bi bi-arrow-up-right me-1"></i>
                    <span>Tăng 100% so với tháng trước</span>
                </div>
            </div>
        </div>

        <!-- Card 2: Kỳ lương hoạt động -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-xs rounded-4 bg-white p-4 kpi-card h-100">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="text-xs fw-bold text-slate-500 text-uppercase tracking-wider">Kỳ lương hoạt động</span>
                    <div class="kpi-icon-circle bg-purple-50 text-purple">
                        <i class="bi bi-calendar3"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline gap-2 mb-2">
                    <span class="kpi-number text-slate-900">@selectedPeriod</span>
                    <span class="kpi-status-badge badge-neutral">22 công</span>
                </div>
                <div class="text-slate-400 small" style="font-size: 12.5px;">
                    <i class="bi bi-clock-history me-1"></i> Chu kỳ: 01/10 - 31/10/2026
                </div>
            </div>
        </div>

        <!-- Card 3: Phiếu lương đã lập -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-xs rounded-4 bg-white p-4 kpi-card h-100">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="text-xs fw-bold text-slate-500 text-uppercase tracking-wider">Phiếu lương đã lập</span>
                    <div class="kpi-icon-circle bg-emerald-50 text-emerald-600">
                        <i class="bi bi-receipt"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline gap-2 mb-2">
                    <span class="kpi-number text-slate-900">@totalPayslips <span class="fs-5 fw-normal text-slate-400">/ @totalEmployees</span></span>
                    <span class="kpi-status-badge badge-active">100%</span>
                </div>
                <div class="text-slate-500 small" style="font-size: 12.5px;">
                    Tổng chi: <strong class="text-slate-800 fw-bold">@totalNetSalary.ToString("N0") ₫</strong>
                </div>
            </div>
        </div>

        <!-- Card 4: Trạng thái sổ lương -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-xs rounded-4 bg-white p-4 kpi-card h-100">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="text-xs fw-bold text-slate-500 text-uppercase tracking-wider">Trạng thái sổ lương</span>
                    <div class="kpi-icon-circle bg-amber-50 text-amber-600">
                        <i class="bi bi-file-earmark-check"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline gap-2 mb-2">
                    <span class="kpi-number text-amber-600" style="font-size: 1.5rem;">Bản Nháp (Draft)</span>
                </div>
                <div class="text-slate-400 small" style="font-size: 12.5px;">
                    <i class="bi bi-pencil-square me-1"></i> Sẵn sàng cập nhật & duyệt
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Middle Charts Row: 50% - 50% Grid (Cơ cấu chi phí lương & Xu hướng quỹ lương) -->
    <div class="row g-4">
        <!-- Col Left (6/12): Cơ Cấu Chi Phí Lương (Donut Chart) -->
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-xs rounded-4 bg-white p-4 h-100 d-flex flex-column justify-content-between main-chart-card">
                <div>
                    <!-- Header with Period Dropdown -->
                    <div class="d-flex justify-content-between align-items-center pb-3 border-bottom mb-4">
                        <div class="d-flex align-items-center gap-2.5">
                            <div class="chart-header-icon bg-blue-50 text-primary">
                                <i class="bi bi-pie-chart-fill"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold text-slate-900 mb-0">Cơ cấu chi phí lương</h5>
                                <div class="text-slate-400 small" style="font-size: 12px;">Phân bổ chi tiết ngân sách lương tháng 10/2026</div>
                            </div>
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary bg-white text-slate-600 py-1.5 px-3 rounded-3 d-flex align-items-center gap-1.5 border-slate-200" style="font-size: 12px;">
                                <span>Tháng 10/2026</span>
                                <i class="bi bi-chevron-down text-slate-400" style="font-size: 10px;"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Chart & Legend Container -->
                    <div class="row align-items-center g-4 my-2">
                        <!-- Donut SVG on Left -->
                        <div class="col-12 col-sm-5 text-center">
                            <div class="donut-container position-relative d-inline-block">
                                <svg width="170" height="170" viewBox="0 0 100 100">
                                    <!-- Background track -->
                                    <circle cx="50" cy="50" r="38" fill="transparent" stroke="#f1f5f9" stroke-width="12" />
                                    <!-- Segment 1: Blue (Basic Salary - 87%) -->
                                    <circle cx="50" cy="50" r="38" fill="transparent" stroke="#2563eb" stroke-width="12"
                                            stroke-dasharray="207.7 238.8" stroke-dashoffset="0" transform="rotate(-90 50 50)" />
                                    <!-- Segment 2: Green (Allowance - 11%) -->
                                    <circle cx="50" cy="50" r="38" fill="transparent" stroke="#10b981" stroke-width="12"
                                            stroke-dasharray="26.3 238.8" stroke-dashoffset="-207.7" transform="rotate(-90 50 50)" />
                                    <!-- Segment 3: Amber (OT - 2%) -->
                                    <circle cx="50" cy="50" r="38" fill="transparent" stroke="#f59e0b" stroke-width="12"
                                            stroke-dasharray="4.8 238.8" stroke-dashoffset="-234" transform="rotate(-90 50 50)" />
                                </svg>
                                <!-- Center Text -->
                                <div class="donut-center-text">
                                    <div class="fw-bold text-slate-900" style="font-size: 14px; letter-spacing: -0.02em;">55.113.637 ₫</div>
                                    <div class="text-slate-400 fw-medium" style="font-size: 11px;">Tổng quỹ lương</div>
                                </div>
                            </div>
                        </div>

                        <!-- Legend Details on Right -->
                        <div class="col-12 col-sm-7">
                            <div class="d-flex flex-column gap-3" style="font-size: 13px;">
                                <!-- Item 1 -->
                                <div class="p-2.5 rounded-3 bg-slate-50 d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="donut-bullet bullet-blue"></span>
                                        <span class="text-slate-700 fw-medium">Lương cơ bản công chuẩn</span>
                                    </div>
                                    <div class="text-end">
                                        <span class="fw-bold text-slate-900">48.000.000 ₫</span>
                                        <span class="badge bg-blue-100 text-primary ms-1.5" style="font-size: 11px;">87%</span>
                                    </div>
                                </div>

                                <!-- Item 2 -->
                                <div class="p-2.5 rounded-3 bg-slate-50 d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="donut-bullet bullet-green"></span>
                                        <span class="text-slate-700 fw-medium">Phụ cấp & trách nhiệm</span>
                                    </div>
                                    <div class="text-end">
                                        <span class="fw-bold text-slate-900">6.000.000 ₫</span>
                                        <span class="badge bg-emerald-100 text-emerald-700 ms-1.5" style="font-size: 11px;">11%</span>
                                    </div>
                                </div>

                                <!-- Item 3 -->
                                <div class="p-2.5 rounded-3 bg-slate-50 d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="donut-bullet bullet-amber"></span>
                                        <span class="text-slate-700 fw-medium">Làm thêm giờ (OT 150%)</span>
                                    </div>
                                    <div class="text-end">
                                        <span class="fw-bold text-slate-900">1.113.637 ₫</span>
                                        <span class="badge bg-amber-100 text-amber-700 ms-1.5" style="font-size: 11px;">2%</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Footer Summary Line -->
                <div class="border-top pt-3 mt-3 d-flex justify-content-between align-items-center text-slate-600 bg-slate-50 p-3 rounded-3" style="font-size: 13px;">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-shield-check text-slate-400"></i>
                        <span>Khấu trừ nghĩa vụ (BHXH & Thuế TNCN):</span>
                    </div>
                    <strong class="text-slate-900 fw-bold fs-6">@totalDeductions.ToString("N0") ₫</strong>
                </div>
            </div>
        </div>

        <!-- Col Right (6/12): Xu Hướng Quỹ Lương (Smooth Line Area Chart) -->
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-xs rounded-4 bg-white p-4 h-100 d-flex flex-column justify-content-between main-chart-card">
                <div>
                    <!-- Header with Range Dropdown -->
                    <div class="d-flex justify-content-between align-items-center pb-3 border-bottom mb-3">
                        <div class="d-flex align-items-center gap-2.5">
                            <div class="chart-header-icon bg-emerald-50 text-emerald-600">
                                <i class="bi bi-graph-up-arrow"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold text-slate-900 mb-0">Xu hướng quỹ lương</h5>
                                <div class="text-slate-400 small" style="font-size: 12px;">Biến động ngân sách chi trả 6 tháng gần nhất</div>
                            </div>
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary bg-white text-slate-600 py-1.5 px-3 rounded-3 d-flex align-items-center gap-1.5 border-slate-200" style="font-size: 12px;">
                                <span>6 tháng gần nhất</span>
                                <i class="bi bi-chevron-down text-slate-400" style="font-size: 10px;"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Area Line Chart SVG (6 Months: 05/2026 -> 10/2026) -->
                    <div class="trend-chart-wrapper position-relative py-3">
                        <svg width="100%" height="200" viewBox="0 0 500 170" preserveAspectRatio="none">
                            <defs>
                                <linearGradient id="trendGradient" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0%" stop-color="#3B82F6" stop-opacity="0.30" />
                                    <stop offset="100%" stop-color="#3B82F6" stop-opacity="0.0" />
                                </linearGradient>
                            </defs>

                            <!-- Horizontal Grid Lines -->
                            <line x1="45" y1="20" x2="490" y2="20" stroke="#F1F5F9" stroke-width="1" stroke-dasharray="4 4" />
                            <text x="5" y="24" fill="#94A3B8" font-size="10.5" font-weight="500">80 tr</text>

                            <line x1="45" y1="50" x2="490" y2="50" stroke="#F1F5F9" stroke-width="1" stroke-dasharray="4 4" />
                            <text x="5" y="54" fill="#94A3B8" font-size="10.5" font-weight="500">60 tr</text>

                            <line x1="45" y1="80" x2="490" y2="80" stroke="#F1F5F9" stroke-width="1" stroke-dasharray="4 4" />
                            <text x="5" y="84" fill="#94A3B8" font-size="10.5" font-weight="500">40 tr</text>

                            <line x1="45" y1="110" x2="490" y2="110" stroke="#F1F5F9" stroke-width="1" stroke-dasharray="4 4" />
                            <text x="5" y="114" fill="#94A3B8" font-size="10.5" font-weight="500">20 tr</text>

                            <line x1="45" y1="140" x2="490" y2="140" stroke="#E2E8F0" stroke-width="1" />
                            <text x="25" y="144" fill="#94A3B8" font-size="10.5" font-weight="500">0</text>

                            <!-- Filled Area under Curve -->
                            <polygon points="55,115 135,105 215,90 295,80 375,70 455,55 455,140 55,140" fill="url(#trendGradient)" />

                            <!-- Smooth Curve Line -->
                            <polyline points="55,115 135,105 215,90 295,80 375,70 455,55" fill="none" stroke="#2563EB" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />

                            <!-- 6 Data Points (Circles) -->
                            <circle cx="55" cy="115" r="4.5" fill="#2563EB" stroke="#FFFFFF" stroke-width="2.5" />
                            <circle cx="135" cy="105" r="4.5" fill="#2563EB" stroke="#FFFFFF" stroke-width="2.5" />
                            <circle cx="215" cy="90" r="4.5" fill="#2563EB" stroke="#FFFFFF" stroke-width="2.5" />
                            <circle cx="295" cy="80" r="4.5" fill="#2563EB" stroke="#FFFFFF" stroke-width="2.5" />
                            <circle cx="375" cy="70" r="4.5" fill="#2563EB" stroke="#FFFFFF" stroke-width="2.5" />
                            <!-- Highlighted active point -->
                            <circle cx="455" cy="55" r="6" fill="#1D4ED8" stroke="#FFFFFF" stroke-width="3" />
                        </svg>

                        <!-- X-Axis Labels -->
                        <div class="d-flex justify-content-between text-slate-500 ps-5 pe-3 fw-medium" style="font-size: 11px; margin-top: -4px;">
                            <span>T05/2026</span>
                            <span>T06/2026</span>
                            <span>T07/2026</span>
                            <span>T08/2026</span>
                            <span>T09/2026</span>
                            <span class="text-primary fw-bold">T10/2026</span>
                        </div>
                    </div>
                </div>

                <!-- Footer Summary Line -->
                <div class="border-top pt-3 mt-3 d-flex justify-content-between align-items-center text-slate-600 bg-slate-50 p-3 rounded-3" style="font-size: 13px;">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-info-circle text-slate-400"></i>
                        <span>Đỉnh chi trả: <strong>55.113.637 ₫</strong> (Tháng 10/2026)</span>
                    </div>
                    <span class="badge bg-emerald-100 text-emerald-700 px-2.5 py-1.5 fw-semibold" style="font-size: 12px;">
                        <i class="bi bi-graph-up me-1"></i> Tăng trưởng ổn định
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .dashboard-page-wrapper {
        max-width: 1440px;
        margin: 0 auto;
    }

    /* Welcome Card Styling */
    .welcome-card {
        background: #ffffff;
        border: 1px solid #e2e8f0 !important;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.04), 0 1px 2px -1px rgba(0, 0, 0, 0.04) !important;
    }

    .welcome-user-name {
        font-size: 1.85rem;
    }

    .status-dot-pulse {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        display: inline-block;
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 5px rgba(16, 185, 129, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }

    .period-select-btn {
        font-size: 12.5px;
        transition: all 0.2s ease;
    }
    .period-select-btn:hover {
        background-color: #f8fafc !important;
        border-color: #cbd5e1 !important;
    }

    /* KPI Cards Styling */
    .kpi-card {
        border: 1px solid #e2e8f0 !important;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.04) !important;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .kpi-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.05) !important;
        border-color: #cbd5e1 !important;
    }

    .kpi-icon-circle {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .kpi-number {
        font-size: 1.85rem;
        font-weight: 700;
        letter-spacing: -0.025em;
        line-height: 1;
    }

    .kpi-status-badge {
        font-size: 11.5px;
        font-weight: 600;
        padding: 2.5px 8.5px;
        border-radius: 9999px;
    }

    .badge-active {
        background-color: #ecfdf5;
        color: #059669;
        border: 1px solid #a7f3d0;
    }

    .badge-neutral {
        background-color: #f1f5f9;
        color: #475569;
        border: 1px solid #e2e8f0;
    }

    /* Main Chart Cards Styling */
    .main-chart-card {
        border: 1px solid #e2e8f0 !important;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.04) !important;
        min-height: 420px;
    }

    .chart-header-icon {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    /* Donut Chart Center Text */
    .donut-center-text {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        line-height: 1.2;
    }

    .donut-bullet {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        display: inline-block;
        flex-shrink: 0;
    }

    .bullet-blue { background-color: #2563eb; }
    .bullet-green { background-color: #10b981; }
    .bullet-amber { background-color: #f59e0b; }

    /* Trend Chart Styling */
    .trend-chart-wrapper {
        min-height: 190px;
    }
</style>

@code {
    private string selectedPeriod = "10/2026";
    private int totalEmployees = 3;
    private int totalPayslips = 3;
    private decimal totalNetSalary = 49260910m;
    private decimal totalDeductions = 5852727m;

    protected override async Task OnInitializedAsync()
    {
        var emps = await EmployeeRepo.GetAllEmployeesAsync();
        totalEmployees = emps.Count();

        var recentPayslips = (await PayslipRepo.GetPayslipsByPeriodAsync(10, 2026)).ToList();
        totalPayslips = recentPayslips.Count;
        if (recentPayslips.Any())
        {
            totalNetSalary = recentPayslips.Sum(p => p.NetSalary);
            totalDeductions = recentPayslips.Sum(p => p.TotalDeductions);
        }
    }
}
