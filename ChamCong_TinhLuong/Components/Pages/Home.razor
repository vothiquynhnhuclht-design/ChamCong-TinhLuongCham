@page "/"
@inject IEmployeeRepository EmployeeRepo
@inject IAttendanceRepository AttendanceRepo
@inject IDepartmentRepository DepartmentRepo
@inject IPayslipRepository PayslipRepo
@inject ILeaveRequestRepository LeaveRepo
@inject UserSessionService UserSession
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Tổng Quan - HRM Enterprise</PageTitle>

<div class="overview-container">

    @if (UserSession.IsAdminHr)
    {
        <!-- Thanh chuyển đổi góc nhìn Quản trị / Nhân viên -->
        <div class="role-switcher-bar mb-3.5 d-flex align-items-center justify-content-between p-2.5 px-3 bg-white rounded-3 shadow-xs">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 rounded-2">
                    <i class="bi bi-shield-check me-1"></i>Tài khoản Quản trị
                </span>
                <span class="text-slate-500 small">Đang xem trước giao diện:</span>
            </div>
            <div class="btn-group btn-group-sm" role="group">
                <button type="button" class="btn @(viewMode == "Employee" ? "btn-primary shadow-xs" : "btn-outline-secondary") px-3 fw-semibold" @onclick='() => viewMode = "Employee"'>
                    <i class="bi bi-person me-1"></i>Giao diện Nhân viên
                </button>
                <button type="button" class="btn @(viewMode == "Admin" ? "btn-primary shadow-xs" : "btn-outline-secondary") px-3 fw-semibold" @onclick='() => viewMode = "Admin"'>
                    <i class="bi bi-bar-chart-steps me-1"></i>Giao diện Quản trị / HR
                </button>
            </div>
        </div>
    }

    <!-- Thông báo kết quả nộp đơn nghỉ phép thành công -->
    @if (!string.IsNullOrEmpty(alertSuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 py-2.5 px-3 rounded-3 mb-3 shadow-xs" role="alert">
            <i class="bi bi-check-circle-fill text-success fs-5"></i>
            <div class="small">
                <strong>Thành công:</strong> @alertSuccessMessage
            </div>
            <button type="button" class="btn-close" @onclick="() => alertSuccessMessage = null"></button>
        </div>
    }

    @if (viewMode == "Employee" || UserSession.IsEmployee)
    {
        <!-- ========================================================================================= -->
        <!-- GIAO DIỆN TỔNG QUAN PHÂN QUYỀN NHÂN VIÊN (MINIMALIST B2B SAAS THEO MOCKUP CHUẨN) -->
        <!-- ========================================================================================= -->

        <!-- 1. BANNER CHÀO MỪNG (GREETING BANNER) -->
        <div class="welcome-banner mb-4">
            <div class="d-flex align-items-center justify-content-between position-relative h-100">
                <div class="welcome-text-content">
                    <h1 class="welcome-heading mb-1.5">
                        Xin chào, @(string.IsNullOrEmpty(currentEmployee?.FullName) ? (string.IsNullOrEmpty(UserSession.CurrentEmployeeName) ? "Nguyễn Thị Mai" : UserSession.CurrentEmployeeName) : currentEmployee.FullName)!
                    </h1>
                    <p class="welcome-subheading mb-0">
                        Chúc bạn một ngày làm việc hiệu quả và nhiều năng lượng!
                    </p>
                </div>

                <!-- Minh họa đồ họa cô gái làm việc tại bàn (Anime/Flat Illustration chuẩn Mockup) -->
                <div class="welcome-art-wrapper d-none d-md-block">
                    <svg width="220" height="110" viewBox="0 0 220 110" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <!-- Nền pastel tròn & mây trôi mờ -->
                        <circle cx="160" cy="55" r="45" fill="#FCE7F3" opacity="0.45" />
                        <circle cx="65" cy="40" r="16" fill="#EDE9FE" opacity="0.6" />
                        <circle cx="88" cy="22" r="9" fill="#E0F2FE" opacity="0.7" />

                        <!-- Chậu cây xanh bên phải -->
                        <path d="M196 90C194 72 201 64 207 60C213 64 219 72 217 90" fill="#34D399" opacity="0.85" />
                        <path d="M185 90C183 76 190 70 195 66C200 70 205 76 203 90" fill="#10B981" opacity="0.75" />
                        <rect x="188" y="90" width="22" height="15" rx="3" fill="#D97706" opacity="0.8" />

                        <!-- Mặt bàn làm việc phẳng -->
                        <rect x="35" y="92" width="165" height="5" rx="2.5" fill="#CBD5E1" />

                        <!-- Cô gái ngồi làm việc -->
                        <!-- Tóc dài xõa vai -->
                        <path d="M123 35C123 20 132 15 142 15C153 15 158 22 157 35C154 32 147 31 142 36C137 31 130 32 123 35Z" fill="#1E293B" />
                        <path d="M123 35C120 46 122 58 126 64C128 67 131 69 133 71" stroke="#1E293B" stroke-width="5" stroke-linecap="round" />
                        
                        <!-- Khuôn mặt và cổ -->
                        <circle cx="143" cy="36" r="13" fill="#FDE047" opacity="0.4" />
                        <circle cx="143" cy="36" r="12" fill="#FED7AA" />
                        <!-- Nụ cười & Mắt tinh tế -->
                        <circle cx="139" cy="34" r="1.5" fill="#0F172A" />
                        <circle cx="147" cy="34" r="1.5" fill="#0F172A" />
                        <path d="M141 40C142 42 144 42 145 40" stroke="#0F172A" stroke-width="1.2" stroke-linecap="round" />

                        <!-- Thân trên áo xanh cobalt -->
                        <path d="M126 68C126 55 134 50 143 50C152 50 160 55 160 68L165 92H121L126 68Z" fill="#2563EB" />
                        <!-- Cánh tay vươn tới bàn phím laptop -->
                        <path d="M130 73L138 88H152L156 73" stroke="#2563EB" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
                        <circle cx="144" cy="88" r="3" fill="#FED7AA" />

                        <!-- Laptop hiện đại -->
                        <rect x="134" y="78" width="30" height="14" rx="2" fill="#0F172A" />
                        <rect x="137" y="80" width="24" height="10" rx="1" fill="#BAE6FD" />
                        <line x1="128" y1="92" x2="170" y2="92" stroke="#64748B" stroke-width="3" stroke-linecap="round" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- 2. BA THẺ THAO TÁC NHANH (3 QUICK ACCESS CARDS CHUẨN MOCKUP) -->
        <div class="row g-3.5 mb-4">
            
            <!-- Card 1: Chấm công -->
            <div class="col-12 col-md-4">
                <div class="quick-card d-flex align-items-center justify-content-between cursor-pointer" @onclick='() => Navigation.NavigateTo("/attendance")'>
                    <div class="d-flex align-items-center gap-3">
                        <div class="quick-icon-circle icon-clock-bg">
                            <i class="bi bi-clock"></i>
                        </div>
                        <div>
                            <div class="quick-card-title">Chấm công</div>
                            <div class="quick-card-sub">Xem lịch làm việc, check-in/out</div>
                        </div>
                    </div>
                    <div class="quick-arrow text-slate-400">
                        <i class="bi bi-arrow-right"></i>
                    </div>
                </div>
            </div>

            <!-- Card 2: Đơn xin nghỉ phép (CLICK ĐỂ MỞ MODAL TẠO ĐƠN TRỰC TIẾP) -->
            <div class="col-12 col-md-4">
                <div class="quick-card d-flex align-items-center justify-content-between cursor-pointer" @onclick="OpenCreateLeaveModal">
                    <div class="d-flex align-items-center gap-3">
                        <div class="quick-icon-circle icon-file-bg">
                            <i class="bi bi-file-earmark-text"></i>
                        </div>
                        <div>
                            <div class="quick-card-title">Đơn xin nghỉ phép</div>
                            <div class="quick-card-sub">Tạo đơn nghỉ, theo dõi trạng thái</div>
                        </div>
                    </div>
                    <div class="quick-arrow text-slate-400">
                        <i class="bi bi-arrow-right"></i>
                    </div>
                </div>
            </div>

            <!-- Card 3: Xem bảng lương -->
            <div class="col-12 col-md-4">
                <div class="quick-card d-flex align-items-center justify-content-between cursor-pointer" @onclick='() => Navigation.NavigateTo("/payroll")'>
                    <div class="d-flex align-items-center gap-3">
                        <div class="quick-icon-circle icon-payroll-bg">
                            <i class="bi bi-file-earmark-spreadsheet"></i>
                        </div>
                        <div>
                            <div class="quick-card-title">Xem bảng lương</div>
                            <div class="quick-card-sub">Xem thông tin lương, phúc lợi</div>
                        </div>
                    </div>
                    <div class="quick-arrow text-slate-400">
                        <i class="bi bi-arrow-right"></i>
                    </div>
                </div>
            </div>

        </div>

        <!-- 3. KHU VỰC NỘI DUNG CHÍNH (8 CỘT TRÁI - 4 CỘT PHẢI) -->
        <div class="row g-4 mb-4">
            
            <!-- CỘT TRÁI (8 CỘT): LỊCH LÀM VIỆC CỦA TÔI & CHÂM NGÔN TRUYỀN CẢM HỨNG -->
            <div class="col-12 col-lg-8">
                
                <!-- Card: Lịch làm việc của tôi -->
                <div class="content-box schedule-card mb-4">
                    <!-- Header -->
                    <div class="schedule-header d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-calendar-event text-primary fs-5"></i>
                            <h2 class="section-title mb-0">Lịch làm việc của tôi</h2>
                        </div>

                        <!-- Date Navigation -->
                        <div class="d-flex align-items-center gap-2">
                            <div class="date-display-badge">
                                <i class="bi bi-calendar3 me-1.5 text-slate-500"></i>
                                <span>@GetVietnameseDayName(selectedDate), @selectedDate.ToString("dd/MM/yyyy")</span>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <button class="btn-nav-arrow" title="Ngày trước" @onclick="GoPreviousDay">
                                    <i class="bi bi-chevron-left"></i>
                                </button>
                                <button class="btn-nav-arrow" title="Ngày kế tiếp" @onclick="GoNextDay">
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Body: 2 Sub-columns -->
                    <div class="schedule-body">
                        <div class="row g-0">
                            
                            <!-- Sub-col 1: 7 ngày trong tuần (35% width) -->
                            <div class="col-12 col-md-5 col-lg-4 schedule-days-pane">
                                <div class="d-flex flex-column gap-1">
                                    @foreach (var day in currentWeekDays)
                                    {
                                        bool isSelected = day.Date == selectedDate.Date;

                                        <div class="schedule-day-row @(isSelected ? "is-active" : "") cursor-pointer"
                                             @onclick="() => SelectDay(day)">
                                            <div class="day-icon-circle-sm">
                                                <i class="bi bi-calendar @(isSelected ? "text-primary" : "text-slate-400")"></i>
                                            </div>
                                            <div>
                                                <div class="day-name @(isSelected ? "text-primary fw-bold" : "text-slate-800 fw-semibold")">
                                                    @GetVietnameseDayName(day)
                                                </div>
                                                <div class="day-date text-slate-400">
                                                    @day.ToString("dd/MM/yyyy")
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Sub-col 2: Timeline chi tiết ca làm việc (65% width) -->
                            <div class="col-12 col-md-7 col-lg-8 schedule-timeline-pane">
                                @if (selectedDate.DayOfWeek == DayOfWeek.Saturday || selectedDate.DayOfWeek == DayOfWeek.Sunday)
                                {
                                    <div class="weekend-empty-box text-center py-5">
                                        <i class="bi bi-cup-hot fs-1 text-slate-300 d-block mb-2"></i>
                                        <h3 class="fw-bold text-slate-700 fs-6 mb-1">Nghỉ cuối tuần</h3>
                                        <p class="small text-slate-400 mb-0">Hôm nay là ngày nghỉ định kỳ theo quy chế công ty.</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="timeline-slot-list">
                                        
                                        <!-- Slot 1: Ca Sáng (08:00 - 12:00) -->
                                        <div class="timeline-slot d-flex align-items-center">
                                            <div class="timeline-slot-time">08:00 - 12:00</div>
                                            <div class="timeline-dot dot-blue"></div>
                                            <div class="timeline-info">
                                                <div class="timeline-title">Làm việc tại văn phòng</div>
                                                <div class="timeline-sub">
                                                    <i class="bi bi-geo-alt me-1 text-slate-400"></i>@(currentEmployee?.Department?.DepartmentName ?? "Phòng Kinh doanh")
                                                </div>
                                            </div>
                                        </div>

                                        <div class="timeline-separator"></div>

                                        <!-- Slot 2: Nghỉ trưa (12:00 - 13:00) -->
                                        <div class="timeline-slot d-flex align-items-center">
                                            <div class="timeline-slot-time">12:00 - 13:00</div>
                                            <div class="timeline-dot dot-green"></div>
                                            <div class="timeline-info">
                                                <div class="timeline-title">Nghỉ trưa</div>
                                                <div class="timeline-sub">
                                                    <i class="bi bi-cup-hot me-1 text-slate-400"></i>Căn tin công ty
                                                </div>
                                            </div>
                                        </div>

                                        <div class="timeline-separator"></div>

                                        <!-- Slot 3: Ca Chiều (13:00 - 17:00) -->
                                        <div class="timeline-slot d-flex align-items-center">
                                            <div class="timeline-slot-time">13:00 - 17:00</div>
                                            <div class="timeline-dot dot-purple"></div>
                                            <div class="timeline-info">
                                                <div class="timeline-title">Làm việc tại văn phòng</div>
                                                <div class="timeline-sub">
                                                    <i class="bi bi-geo-alt me-1 text-slate-400"></i>@(currentEmployee?.Department?.DepartmentName ?? "Phòng Kinh doanh")
                                                </div>
                                            </div>
                                        </div>

                                    </div>

                                    @if (currentDayAttendance != null)
                                    {
                                        <div class="attendance-status-banner mt-4 d-flex align-items-center justify-content-between">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-check-circle-fill text-emerald-600 fs-5"></i>
                                                <span class="small text-slate-800">
                                                    Đã chấm công: Vào <strong>@(currentDayAttendance.CheckIn.HasValue ? currentDayAttendance.CheckIn.Value.ToString(@"hh\:mm") : "0")</strong> 
                                                    - Ra <strong>@(currentDayAttendance.CheckOut.HasValue ? currentDayAttendance.CheckOut.Value.ToString(@"hh\:mm") : "0")</strong>
                                                </span>
                                            </div>
                                            <span class="badge bg-emerald-600 text-white rounded-pill px-2.5 py-1">@currentDayAttendance.ActualWorkDays.ToString("0.#") công</span>
                                        </div>
                                    }
                                }
                            </div>

                        </div>
                    </div>
                </div>

                <!-- Card: Châm ngôn tạo động lực (Motivation Quote Card Chuẩn Mockup) -->
                <div class="motivation-quote-card">
                    <div class="d-flex align-items-center justify-content-between position-relative">
                        
                        <!-- 3D Calendar & Clock Graphic -->
                        <div class="motivation-graphic-box flex-shrink-0">
                            <svg width="68" height="60" viewBox="0 0 68 60" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <!-- Thân lịch để bàn trắng/đỏ -->
                                <rect x="8" y="14" width="46" height="38" rx="7" fill="#FFFFFF" stroke="#E2E8F0" stroke-width="1.5" />
                                <path d="M8 21C8 17.134 11.134 14 15 14H47C50.866 14 54 17.134 54 21V25H8V21Z" fill="#EF4444" />
                                <!-- Khuyên lò xo đỏ -->
                                <rect x="18" y="10" width="4" height="8" rx="2" fill="#F87171" stroke="#FFFFFF" stroke-width="1" />
                                <rect x="29" y="10" width="4" height="8" rx="2" fill="#F87171" stroke="#FFFFFF" stroke-width="1" />
                                <rect x="40" y="10" width="4" height="8" rx="2" fill="#F87171" stroke="#FFFFFF" stroke-width="1" />
                                <!-- Lưới ngày trên tờ lịch -->
                                <rect x="15" y="31" width="6" height="4" rx="1" fill="#93C5FD" />
                                <rect x="25" y="31" width="6" height="4" rx="1" fill="#CBD5E1" />
                                <rect x="35" y="31" width="6" height="4" rx="1" fill="#CBD5E1" />
                                <rect x="15" y="39" width="6" height="4" rx="1" fill="#CBD5E1" />
                                <rect x="25" y="39" width="6" height="4" rx="1" fill="#3B82F6" />
                                <rect x="35" y="39" width="6" height="4" rx="1" fill="#CBD5E1" />

                                <!-- Đồng hồ nhỏ màu xanh bên cạnh -->
                                <circle cx="48" cy="44" r="12" fill="#3B82F6" stroke="#FFFFFF" stroke-width="2.5" />
                                <circle cx="48" cy="44" r="9.5" fill="#2563EB" />
                                <path d="M48 38V44L52 46" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" />
                            </svg>
                        </div>

                        <!-- Chữ châm ngôn -->
                        <div class="motivation-quote-text ps-3 flex-grow-1">
                            <div class="d-flex align-items-start gap-2">
                                <span class="quote-mark">“</span>
                                <div class="quote-lines">
                                    <div>Làm việc chăm chỉ hôm nay</div>
                                    <div>để chạm đến thành công ngày mai!”</div>
                                </div>
                            </div>
                        </div>

                        <!-- Lá cây trang trí màu tím pastel góc phải -->
                        <div class="motivation-botanical-art d-none d-sm-block">
                            <svg width="55" height="55" viewBox="0 0 55 55" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M45 45C35 45 25 35 25 25C25 15 35 5 45 5C45 15 45 25 45 45Z" fill="#C4B5FD" opacity="0.6" />
                                <path d="M45 45C40 38 35 30 40 20C42 16 45 14 48 10C48 20 48 32 45 45Z" fill="#A78BFA" opacity="0.7" />
                                <path d="M30 48C24 44 20 38 22 30C23 26 26 22 28 18C30 24 30 36 30 48Z" fill="#C4B5FD" opacity="0.4" />
                            </svg>
                        </div>

                    </div>
                </div>

            </div>

            <!-- CỘT PHẢI (4 CỘT): THÔNG TIN CÁ NHÂN & THÔNG BÁO MỚI NHẤT -->
            <div class="col-12 col-lg-4">
                
                <!-- Card 1: Thông tin cá nhân -->
                <div class="content-box profile-card mb-4">
                    <!-- Header -->
                    <div class="profile-card-header d-flex align-items-center gap-2 mb-3.5">
                        <i class="bi bi-person-fill text-primary fs-5"></i>
                        <h2 class="section-title mb-0">Thông tin cá nhân</h2>
                    </div>

                    <!-- Avatar + Name + Subtitle -->
                    <div class="profile-avatar-center text-center pb-3">
                        <div class="profile-avatar-frame mx-auto mb-2">
                            <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=160&auto=format&fit=crop&q=80" 
                                 alt="Avatar" class="avatar-photo" 
                                 onerror="this.src='https://ui-avatars.com/api/?name=Nguyen+Thi+Mai&background=0D8ABC&color=fff';" />
                        </div>
                        <h3 class="profile-user-name mb-0.5">
                            @(string.IsNullOrEmpty(currentEmployee?.FullName) ? (string.IsNullOrEmpty(UserSession.CurrentEmployeeName) ? "Nguyễn Thị Mai" : UserSession.CurrentEmployeeName) : currentEmployee.FullName)
                        </h3>
                        <div class="profile-user-role mb-1">
                            @(string.IsNullOrEmpty(currentEmployee?.Position) ? "Nhân viên" : currentEmployee.Position)
                        </div>
                        <div class="profile-user-code">
                            Mã NV: @(string.IsNullOrEmpty(currentEmployee?.EmployeeCode) ? "NV0012" : currentEmployee.EmployeeCode)
                        </div>
                    </div>

                    <!-- 4 Rows Info (Email, Điện thoại, Ngày sinh, Địa chỉ) -->
                    <div class="profile-info-list py-2.5">
                        
                        <div class="profile-info-row d-flex align-items-center justify-content-between">
                            <div class="info-label d-flex align-items-center gap-2 text-slate-500">
                                <i class="bi bi-envelope text-slate-400"></i>
                                <span>Email</span>
                            </div>
                            <div class="info-value text-truncate" title="@currentEmployee?.Email">
                                @(string.IsNullOrEmpty(currentEmployee?.Email) ? "mai.nguyen@techcorp.com" : currentEmployee.Email)
                            </div>
                        </div>

                        <div class="profile-info-row d-flex align-items-center justify-content-between">
                            <div class="info-label d-flex align-items-center gap-2 text-slate-500">
                                <i class="bi bi-telephone text-slate-400"></i>
                                <span>Số điện thoại</span>
                            </div>
                            <div class="info-value">
                                @(string.IsNullOrEmpty(currentEmployee?.PhoneNumber) ? "0912 345 678" : currentEmployee.PhoneNumber)
                            </div>
                        </div>

                        <div class="profile-info-row d-flex align-items-center justify-content-between">
                            <div class="info-label d-flex align-items-center gap-2 text-slate-500">
                                <i class="bi bi-calendar-check text-slate-400"></i>
                                <span>Ngày vào làm</span>
                            </div>
                            <div class="info-value">
                                @(currentEmployee != null ? currentEmployee.JoinDate.ToString("dd/MM/yyyy") : "10/10/2026")
                            </div>
                        </div>

                        <div class="profile-info-row d-flex align-items-center justify-content-between">
                            <div class="info-label d-flex align-items-center gap-2 text-slate-500">
                                <i class="bi bi-geo-alt text-slate-400"></i>
                                <span>Phòng ban</span>
                            </div>
                            <div class="info-value text-truncate" style="max-width: 175px;" title="@currentEmployee?.Department?.DepartmentName">
                                @(currentEmployee?.Department != null ? currentEmployee.Department.DepartmentName : "Phòng Kinh doanh")
                            </div>
                        </div>

                    </div>

                    <!-- Button: Xem chi tiết -->
                    <div class="profile-action-btn-wrap pt-3">
                        <button class="btn-profile-detail w-100" @onclick='() => Navigation.NavigateTo("/employees")'>
                            <span>Xem chi tiết</span>
                            <i class="bi bi-arrow-right"></i>
                        </button>
                    </div>
                </div>

                <!-- Card 2: Thông báo mới nhất -->
                <div class="content-box announcements-card">
                    <div class="announcements-header d-flex align-items-center justify-content-between mb-3.5">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-bell-fill text-primary fs-5"></i>
                            <h2 class="section-title mb-0">Thông báo mới nhất</h2>
                        </div>
                        <a href="javascript:void(0)" class="link-view-all">
                            Xem tất cả <i class="bi bi-arrow-right ms-0.5"></i>
                        </a>
                    </div>

                    <div class="announcements-list">
                        
                        <!-- Item 1: Lịch nghỉ lễ -->
                        <div class="announcement-row">
                            <div class="d-flex align-items-center justify-content-between">
