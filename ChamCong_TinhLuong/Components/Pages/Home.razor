                </div>

            </div>

        </div>

    }
    else
    {
        <!-- GIAO DIỆN TỔNG QUAN PHÂN QUYỀN QUẢN TRỊ VIÊN / HR (GIỮ NGUYÊN BẢN ADMIN DASHBOARD) -->
