@page "/payroll"
@inject CalculatePayrollUseCase CalculatePayroll
@inject LockPayrollPeriodUseCase LockPayroll
@inject IPayslipRepository PayslipRepo
@inject IEmployeeRepository EmployeeRepo
@inject UserSessionService UserSession
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Quản Lý Tính Lương & Phiếu Lương</PageTitle>

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-cash-stack text-success me-2"></i>Tính Lương & Phiếu Lương (Header - Line)
            </h3>
            <p class="text-muted small mb-0">
                Tuân thủ 2 Luật Nghiệp vụ: Động cơ tính lương trong Database Transaction & Khóa sổ (Locked) bảo mật cấp dòng
            </p>
        </div>

        <div class="d-flex gap-2">
            @if (UserSession.IsAdminHr)
            {
                <button class="btn btn-outline-success fw-bold shadow-sm" @onclick="ExportPayrollCsvAsync" disabled="@(!payslips.Any())">
                    <i class="bi bi-file-earmark-excel-fill me-1"></i> Xuất Bảng Lương (CSV)
                </button>
                <button class="btn btn-primary fw-bold shadow-sm" @onclick="ExecutePayrollCalculationAsync" disabled="@(isLocked || isProcessing)">
                    <i class="bi bi-gear-fill me-1 @(isProcessing ? "spin" : "")"></i>
                    @(isProcessing ? "Đang Tính Toán..." : "Tính Lương Hàng Loạt")
                </button>
                <button class="btn btn-danger fw-bold shadow-sm" @onclick="ExecuteLockPeriodAsync" disabled="@(isLocked || !payslips.Any())">
                    <i class="bi bi-lock-fill me-1"></i> Khóa Sổ Kỳ Này
                </button>
            }
            else
            {
                <button class="btn btn-outline-success fw-bold shadow-sm" @onclick="ExportPayrollCsvAsync" disabled="@(!payslips.Any())">
                    <i class="bi bi-file-earmark-arrow-down-fill me-1"></i> Xuất Phiếu Cá Nhân (CSV)
                </button>
            }
        </div>
    </div>

    <!-- User Role Context Banner -->
    @if (UserSession.IsEmployee)
    {
        <div class="alert alert-info border-info d-flex align-items-center gap-2 py-2 mb-3 shadow-2xs">
            <i class="bi bi-shield-lock-fill fs-5 text-primary"></i>
            <div>
                <strong>Chế độ Phân quyền theo Dữ liệu (Row-Level Security):</strong> Bạn đang đăng nhập với tư cách nhân viên 
                <span class="badge bg-primary">@UserSession.CurrentEmployeeCode - @UserSession.CurrentEmployeeName</span>. 
                Hệ thống chỉ hiển thị phiếu lương của chính bạn, ngăn chặn hoàn toàn việc xem trộm dữ liệu lương người khác (Luật 2).
            </div>
        </div>
    }

    <!-- Feedback Alerts -->
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>@successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>@errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <!-- Control Filter Bar -->
    <div class="card border-0 shadow-sm rounded-3 p-3 bg-white mb-4">
        <div class="row g-3 align-items-center">
            <div class="col-12 col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">Kỳ Lương (Tháng/Năm)</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-calendar3"></i></span>
                    <select class="form-select" @bind="selectedMonth" @bind:after="LoadPayslipsAsync">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m">Tháng @m</option>
                        }
                    </select>
                    <select class="form-select" @bind="selectedYear" @bind:after="LoadPayslipsAsync">
                        <option value="2026">2026</option>
                        <option value="2025">2025</option>
                    </select>
                </div>
            </div>

            <div class="col-12 col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">Số Ngày Công Chuẩn</label>
                <input type="number" class="form-control" @bind="standardWorkDays" step="0.5" min="1" max="31" disabled="@UserSession.IsEmployee" />
            </div>

            <div class="col-12 col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">Trạng Thái Sổ</label>
                <div>
                    @if (isLocked)
                    {
                        <span class="badge bg-danger fs-6 px-3 py-2">
                            <i class="bi bi-lock-fill me-1"></i> ĐÃ KHÓA SỔ (LOCKED)
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark fs-6 px-3 py-2">
                            <i class="bi bi-pencil me-1"></i> BẢN NHÁP (DRAFT)
                        </span>
                    }
                </div>
            </div>

            <div class="col-12 col-md-3 text-md-end mt-md-4">
                <button class="btn btn-outline-secondary w-100" @onclick="LoadPayslipsAsync">
                    <i class="bi bi-arrow-clockwise me-1"></i> Tải Lại Danh Sách
                </button>
            </div>
        </div>
    </div>

    <!-- Summary Numbers -->
    @if (payslips.Any())
    {
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                    <div class="text-muted small fw-semibold">Tổng Số Phiếu Lương</div>
                    <div class="fs-4 fw-bold text-dark mt-1">@payslips.Count bản ghi</div>
                    <div class="text-success small mt-1"><i class="bi bi-people me-1"></i>@(UserSession.IsAdminHr ? "Toàn bộ nhân sự" : "Cá nhân")</div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                    <div class="text-muted small fw-semibold">Tổng Thu Nhập (Gross)</div>
                    <div class="fs-4 fw-bold text-primary mt-1">@payslips.Sum(p => p.GrossSalary).ToString("N0") đ</div>
                    <div class="text-muted small mt-1">Lương công + OT + Phụ cấp</div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                    <div class="text-muted small fw-semibold">Tổng Khấu Trừ</div>
                    <div class="fs-4 fw-bold text-danger mt-1">@payslips.Sum(p => p.TotalDeductions).ToString("N0") đ</div>
                    <div class="text-muted small mt-1">BHXH 8%, BHYT 1.5%, BHTN 1%, Thuế</div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                    <div class="text-muted small fw-semibold">Tổng Thực Nhận (Net)</div>
                    <div class="fs-4 fw-bold text-success mt-1">@payslips.Sum(p => p.NetSalary).ToString("N0") đ</div>
                    <div class="text-success small mt-1"><i class="bi bi-wallet2 me-1"></i>Đã sẵn sàng chi trả</div>
                </div>
            </div>
        </div>
    }

    <!-- Payslips Data Table -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="card-title fw-bold text-dark mb-0">
                <i class="bi bi-table me-2 text-primary"></i>
                @(UserSession.IsAdminHr ? $"Bảng Lương Tổng Hợp Kỳ Tháng {selectedMonth}/{selectedYear}" : $"Phiếu Lương Cá Nhân Kỳ Tháng {selectedMonth}/{selectedYear}")
            </h5>
            <span class="badge bg-light text-secondary border">
                @payslips.Count dòng
            </span>
        </div>

        @if (!payslips.Any())
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-3 text-secondary"></i>
                <h5>Chưa có dữ liệu tính lương cho Kỳ Tháng @selectedMonth/@selectedYear</h5>
                @if (UserSession.IsAdminHr)
                {
                    <p class="small text-secondary mb-3">Vui lòng bấm nút "Tính Lương Hàng Loạt" phía trên để chạy thuật toán tính lương trong Transaction.</p>
                    <button class="btn btn-primary" @onclick="ExecutePayrollCalculationAsync">
                        <i class="bi bi-play-circle-fill me-1"></i> Bắt Đầu Tính Lương Ngay
                    </button>
                }
                else
                {
                    <p class="small text-secondary mb-0">Phòng Nhân sự chưa chốt/tính toán phiếu lương cho kỳ này. Vui lòng quay lại sau.</p>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Mã NV</th>
                            <th>Họ và Tên</th>
                            <th>Phòng Ban</th>
                            <th class="text-center">Công TT / Chuẩn</th>
                            <th class="text-center">Giờ OT</th>
                            <th class="text-end">Thu Nhập (Gross)</th>
                            <th class="text-end">Khấu Trừ</th>
                            <th class="text-end">Thực Nhận (Net)</th>
                            <th class="text-center">Trạng Thái</th>
                            <th class="text-center pe-3">Chi Tiết</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var slip in payslips)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-primary">@slip.Employee?.EmployeeCode</td>
                                <td>
                                    <div class="fw-semibold text-dark">@slip.Employee?.FullName</div>
                                    <div class="small text-muted">@slip.Employee?.Position</div>
                                </td>
                                <td><span class="badge bg-light text-dark border">@slip.Employee?.Department?.DepartmentName</span></td>
                                <td class="text-center">
                                    <span class="fw-bold text-primary">@slip.ActualWorkDays</span> / @slip.StandardWorkDays
                                </td>
                                <td class="text-center">
                                    @if (slip.OvertimeHours > 0)
                                    {
                                        <span class="badge bg-purple text-white">@slip.OvertimeHours h</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">0</span>
                                    }
                                </td>
                                <td class="text-end fw-semibold">@slip.GrossSalary.ToString("N0") đ</td>
                                <td class="text-end text-danger fw-semibold">-@slip.TotalDeductions.ToString("N0") đ</td>
                                <td class="text-end text-success fw-bold fs-6">@slip.NetSalary.ToString("N0") đ</td>
                                <td class="text-center">
                                    @if (slip.Status == PayslipStatus.Locked)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                            <i class="bi bi-lock-fill me-1"></i>Đã Khóa
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                            <i class="bi bi-pencil me-1"></i>Nháp
                                        </span>
                                    }
                                </td>
                                <td class="text-center pe-3">
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewDetailModal(slip)">
                                        <i class="bi bi-eye-fill me-1"></i> Xem Phiếu
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Modal Header - Line Payslip Detail -->
@if (selectedPayslip != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg rounded-3">
                <div class="modal-header bg-dark text-white">
                    <div>
                        <h5 class="modal-title fw-bold mb-0">
                            <i class="bi bi-receipt text-warning me-2"></i>PHIẾU LƯƠNG CHI TIẾT (PAYSLIP)
                        </h5>
                        <div class="small text-white-50">Kỳ lương: Tháng @selectedPayslip.Month/@selectedPayslip.Year • Trạng thái: @selectedPayslip.Status</div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => selectedPayslip = null"></button>
                </div>
                <div class="modal-body p-4 bg-light">
                    <!-- Employee Info Header Card -->
                    <div class="card border-0 shadow-sm rounded-3 p-3 bg-white mb-3">
                        <div class="row g-2 text-sm">
                            <div class="col-6 col-md-4">
                                <span class="text-muted small">Họ và Tên:</span>
                                <div class="fw-bold text-dark">@selectedPayslip.Employee?.FullName</div>
                            </div>
                            <div class="col-6 col-md-4">
                                <span class="text-muted small">Mã Nhân Viên:</span>
                                <div class="fw-bold text-primary">@selectedPayslip.Employee?.EmployeeCode</div>
                            </div>
                            <div class="col-6 col-md-4">
                                <span class="text-muted small">Chức Vụ / Vị Trí:</span>
                                <div class="fw-bold text-dark">@selectedPayslip.Employee?.Position</div>
                            </div>
                            <div class="col-6 col-md-4">
                                <span class="text-muted small">Ngày Công Chuẩn:</span>
                                <div class="fw-bold">@selectedPayslip.StandardWorkDays ngày</div>
                            </div>
                            <div class="col-6 col-md-4">
                                <span class="text-muted small">Ngày Công Thực Tế:</span>
                                <div class="fw-bold text-primary">@selectedPayslip.ActualWorkDays công</div>
                            </div>
                            <div class="col-6 col-md-4">
                                <span class="text-muted small">Làm Thêm Giờ (OT):</span>
                                <div class="fw-bold text-purple">@selectedPayslip.OvertimeHours giờ</div>
                            </div>
                        </div>
                    </div>

                    <!-- Line Items Breakdown (PayslipLine) -->
                    <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white mb-3">
                        <div class="card-header bg-white fw-bold py-2 border-bottom">
                            <i class="bi bi-list-columns-reverse me-1 text-primary"></i> Chi Tiết Các Khoản Thu Nhập & Khấu Trừ (Header - Line)
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm table-striped align-middle mb-0 text-sm">
                                <thead>
                                    <tr class="table-light">
                                        <th class="ps-3">Khoản Mục</th>
                                        <th>Loại</th>
                                        <th>Công Thức / Nguồn Quy Định Pháp Luật</th>
                                        <th class="text-end pe-3">Số Tiền</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var line in selectedPayslip.Lines)
                                    {
                                        <tr>
                                            <td class="ps-3 fw-semibold text-dark">@line.ItemName</td>
                                            <td>
                                                <span class="badge @(line.LineType == PayslipLineType.Earning ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                                                    @(line.LineType == PayslipLineType.Earning ? "Thu Nhập (+)" : "Khấu Trừ (-)")
                                                </span>
                                            </td>
                                            <td class="text-muted small">@line.CalculationNote</td>
                                            <td class="text-end pe-3 fw-bold @(line.LineType == PayslipLineType.Earning ? "text-success" : "text-danger")">
                                                @(line.LineType == PayslipLineType.Earning ? "+" : "-")@line.Amount.ToString("N0") đ
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Net Salary Summary Box -->
                    <div class="card border-0 rounded-3 p-3 text-white" style="background: linear-gradient(135deg, #1e293b, #0f172a);">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-white-50">Tổng Thu Nhập (Gross):</span>
                            <span class="fw-bold fs-6">@selectedPayslip.GrossSalary.ToString("N0") đ</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-white-50">Tổng Khấu Trừ (Bảo hiểm & Thuế):</span>
                            <span class="fw-bold fs-6 text-danger-emphasis">-@selectedPayslip.TotalDeductions.ToString("N0") đ</span>
                        </div>
                        <hr class="border-secondary border-opacity-50 my-2" />
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold fs-5 text-warning">LƯƠNG THỰC NHẬN (NET):</span>
                            <span class="fw-bold fs-4 text-success">@selectedPayslip.NetSalary.ToString("N0") VNĐ</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-white d-flex justify-content-between">
                    <a href="ai-assistant" class="btn btn-outline-purple">
                        <i class="bi bi-robot me-1"></i> Hỏi Trợ Lý AI về Phiếu Này
                    </a>
                    <div>
                        <button type="button" class="btn btn-secondary me-2" @onclick="() => selectedPayslip = null">Đóng</button>
                        <button type="button" class="btn btn-primary" onclick="window.print()">
                            <i class="bi bi-printer-fill me-1"></i> In Phiếu Lương
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private int selectedMonth = 10;
    private int selectedYear = 2026;
    private double standardWorkDays = 22.0;
    private bool isLocked = false;
    private bool isProcessing = false;
    private string? successMessage;
    private string? errorMessage;

    private List<Payslip> payslips = new();
    private Payslip? selectedPayslip;

    protected override async Task OnInitializedAsync()
    {
        UserSession.OnChange += OnUserSessionChanged;
        await LoadPayslipsAsync();
    }

    private async void OnUserSessionChanged()
    {
        await LoadPayslipsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadPayslipsAsync()
    {
        var all = (await PayslipRepo.GetPayslipsByPeriodAsync(selectedMonth, selectedYear)).ToList();
        
        // Row-Level Security: Nếu là nhân viên, chỉ được xem phiếu của chính mình
        if (UserSession.IsEmployee && UserSession.CurrentEmployeeId.HasValue)
        {
            payslips = all.Where(p => p.EmployeeId == UserSession.CurrentEmployeeId.Value).ToList();
        }
        else
        {
            payslips = all;
        }

        isLocked = await PayslipRepo.IsPeriodLockedAsync(selectedMonth, selectedYear);
    }

    private async Task ExecutePayrollCalculationAsync()
    {
        isProcessing = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var result = await CalculatePayroll.ExecuteAsync(selectedMonth, selectedYear, standardWorkDays);
            if (result.Success)
            {
                successMessage = result.Message;
                await LoadPayslipsAsync();
            }
        }
        catch (PayslipLockedException ex)
        {
            errorMessage = $"[Luật Nghiệp vụ 2 Chặn]: {ex.Message}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi tính lương: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task ExecuteLockPeriodAsync()
    {
        try
        {
            await LockPayroll.ExecuteAsync(selectedMonth, selectedYear, "Admin HR");
            isLocked = true;
            successMessage = $"🔒 [Luật Nghiệp vụ 2]: Kỳ lương tháng {selectedMonth}/{selectedYear} đã được KHÓA SỔ thành công! Mọi thao tác tính lại hoặc sửa đổi đã bị vô hiệu hóa.";
            await LoadPayslipsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi khóa sổ: {ex.Message}";
        }
    }

    private async Task ExportPayrollCsvAsync()
    {
        if (!payslips.Any()) return;

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Mã NV,Họ và Tên,Phòng Ban,Chức Vụ,Kỳ Lương,Công Chuẩn,Công Thực Tế,Giờ OT,Lương Cơ Bản,Phụ Cấp,Tổng Thu Nhập (Gross),Tổng Khấu Trừ,Lương Thực Nhận (Net),Trạng Thái");
        foreach (var p in payslips)
        {
            sb.AppendLine($"\"{p.Employee?.EmployeeCode}\",\"{p.Employee?.FullName}\",\"{p.Employee?.Department?.DepartmentName}\",\"{p.Employee?.Position}\",\"{p.Month:D2}/{p.Year}\",{p.StandardWorkDays},{p.ActualWorkDays},{p.OvertimeHours},{p.BasicSalary:F0},{p.Allowance:F0},{p.GrossSalary:F0},{p.TotalDeductions:F0},{p.NetSalary:F0},\"{p.Status}\"");
        }

        var bytes = System.Text.Encoding.UTF8.GetPreamble().Concat(System.Text.Encoding.UTF8.GetBytes(sb.ToString())).ToArray();
        var base64 = Convert.ToBase64String(bytes);
        var filename = $"BangLuong_Thang_{selectedMonth}_{selectedYear}.csv";
        await JS.InvokeVoidAsync("downloadFileFromBase64", filename, "text/csv;charset=utf-8", base64);
    }

    private void ViewDetailModal(Payslip slip)
    {
        selectedPayslip = slip;
    }

    public void Dispose()
    {
        UserSession.OnChange -= OnUserSessionChanged;
    }
}
