@page "/login"
@inject UserSessionService UserSession
@inject NavigationManager Navigation

<PageTitle>Đăng Nhập - Hệ Thống Quản Lý Nhân Sự & Tiền Lương</PageTitle>

<div class="d-flex align-items-center justify-content-center min-vh-100 p-3" style="background-color: #f1f5f9;">
    <div class="w-100" style="max-width: 420px;">
        
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-3 shadow-sm mb-2" style="width: 48px; height: 48px;">
                <i class="bi bi-clock-history fs-3"></i>
            </div>
            <h4 class="fw-bold text-dark mb-1">HRM & Payroll</h4>
            <p class="text-muted small mb-0">Hệ Thống Quản Trị Nhân Sự & Tiền Lương Doanh Nghiệp</p>
        </div>

        <div class="card border-0 shadow-sm rounded-4 p-4 p-sm-4 bg-white">
            <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                <span class="fw-bold text-dark fs-6">Đăng Nhập</span>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle small">Bản quyền 2026</span>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger py-2 px-3 small d-flex align-items-center gap-2 mb-3 rounded-3" role="alert">
                    <i class="bi bi-exclamation-circle-fill text-danger flex-shrink-0"></i>
                    <div>@errorMessage</div>
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success py-2 px-3 small d-flex align-items-center gap-2 mb-3 rounded-3" role="alert">
                    <i class="bi bi-check-circle-fill text-success flex-shrink-0"></i>
                    <div>@successMessage</div>
                </div>
            }

            <form @onsubmit="HandleLoginAsync">
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary mb-1">Tài khoản</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-person"></i>
                        </span>
                        <input type="text" class="form-control border-start-0" 
                               placeholder="Tên đăng nhập hoặc mã nhân viên" 
                               @bind="username" 
                               disabled="@isLoading"
                               autocomplete="username"
                               required />
                    </div>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label small fw-semibold text-secondary mb-0">Mật khẩu</label>
                    </div>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-shield-lock"></i>
                        </span>
                        <input type="@(showPassword ? "text" : "password")" class="form-control border-start-0 border-end-0" 
                               placeholder="Nhập mật khẩu" 
                               @bind="password" 
                               disabled="@isLoading"
                               autocomplete="current-password" />
                        <button type="button" class="btn btn-light border border-start-0 text-muted" @onclick="TogglePasswordVisibility" tabindex="-1">
                            <i class="bi @(showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold rounded-3 shadow-xs d-flex align-items-center justify-content-center gap-2 mt-4" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Đang xác thực...</span>
                    }
                    else
                    {
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span>Đăng Nhập</span>
                    }
                </button>
            </form>
        </div>

        <div class="text-center mt-3 text-muted" style="font-size: 12px;">
            Hệ thống Quản lý Nhân sự & Tiền lương Doanh nghiệp
        </div>

    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnLoginSuccess { get; set; }

    private string username = string.Empty;
    private string password = string.Empty;
    private string? errorMessage;
    private string? successMessage;
    private bool isLoading = false;
    private bool showPassword = false;

    protected override void OnInitialized()
    {
        if (UserSession.IsAuthenticated)
        {
            Navigation.NavigateTo("/", forceLoad: false);
        }
    }

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private async Task HandleLoginAsync()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var pwd = string.IsNullOrWhiteSpace(password) ? "123456" : password;
            var result = await UserSession.LoginAsync(username, pwd);
            if (result.Success)
            {
                successMessage = result.Message;
                if (OnLoginSuccess.HasDelegate)
                {
                    await OnLoginSuccess.InvokeAsync();
                }
                Navigation.NavigateTo("/", forceLoad: false);
            }
            else
            {
                errorMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi đăng nhập: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
